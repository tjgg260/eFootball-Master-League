# Tesseract model — 15 MB, fetched from tesseract-ocr/tessdata_best, not source
tools/tessdata/*.traineddata

# The career save itself. Never commit a database.
*.db
*.db-shm
*.db-wal
*.sqlite

# Game files must never end up in the repo. Only anonymised exports belong in /samples.
*.bin
*.bak
*.cpk
*.pak

# Raw screenshots — keep only the deliberate calibration samples in /samples
*.jpg
*.jpeg
!samples/results-*.png

# The editor's bundled player database: 13 MB of third-party data, not ours to
# redistribute. Its shape is recorded in samples/schema-players.md instead.
samples/editor-bundled-players.csv

# Real exports: game data, not ours to redistribute. Schema docs are the record.
bins/
samples/*.csv
bins-evomod/
bins-evomod-full/
EvoMod_6.0/
*.cpk
*.rar
tools/vendor/sider-full/

build/
*.bak

