<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ════════════════════════════════════════════════════════════════════════════════
       THE DESIGN SYSTEM (UX audit 2026-08-23: 75 ad-hoc hex colors, 87 hand-styled
       buttons, 4 chip radii, 20 font sizes). One token sheet + shared classes; screens
       consume classes, never raw hex. Migrate screens opportunistically — every new or
       touched element MUST use these.

       Palette (the keepers, measured from de-facto usage):
         Surfaces  #0A0E14 app · #0E141C panel · #161E28 card · #1A222C control · #26313F border
         Text      #FFFFFF heading · #C7CEDA body · #8A93A2 muted
         Accents   #2D7DD2 primary · #1F9D4D success · #E0A526 warn · #D64545 danger · #6EA8FF link
       ════════════════════════════════════════════════════════════════════════════════ -->

  <Styles.Resources>
    <ResourceDictionary>
      <SolidColorBrush x:Key="MlSurfaceApp">#0A0E14</SolidColorBrush>
      <SolidColorBrush x:Key="MlSurfacePanel">#0E141C</SolidColorBrush>
      <SolidColorBrush x:Key="MlSurfaceCard">#161E28</SolidColorBrush>
      <SolidColorBrush x:Key="MlSurfaceControl">#1A222C</SolidColorBrush>
      <SolidColorBrush x:Key="MlBorder">#26313F</SolidColorBrush>
      <SolidColorBrush x:Key="MlTextHeading">#FFFFFF</SolidColorBrush>
      <SolidColorBrush x:Key="MlTextBody">#C7CEDA</SolidColorBrush>
      <SolidColorBrush x:Key="MlTextMuted">#8A93A2</SolidColorBrush>
      <!-- the assistant-voice green: positive readouts, status lines (agents' most-wanted token) -->
      <SolidColorBrush x:Key="MlSuccessText">#9FE6B4</SolidColorBrush>
      <SolidColorBrush x:Key="MlPrimary">#2D7DD2</SolidColorBrush>
      <SolidColorBrush x:Key="MlSuccess">#1F9D4D</SolidColorBrush>
      <SolidColorBrush x:Key="MlWarn">#E0A526</SolidColorBrush>
      <SolidColorBrush x:Key="MlDanger">#D64545</SolidColorBrush>
      <SolidColorBrush x:Key="MlLink">#6EA8FF</SolidColorBrush>
      <SolidColorBrush x:Key="MlGold">#D4AC0D</SolidColorBrush>

      <!-- The player radar. These three were repeated as raw hex in every screen that draws a
           hexagon (Squad, Market, Player) — the same values, copied, so a change meant finding
           all of them. The magenta is deliberately outside the status palette: a radar is not a
           good/bad readout, and reusing MlSuccess/MlDanger there would imply a verdict. -->
      <SolidColorBrush x:Key="MlRadarGrid">#3A4759</SolidColorBrush>
      <SolidColorBrush x:Key="MlRadarLine">#FF2D78</SolidColorBrush>
      <SolidColorBrush x:Key="MlRadarFill">#40FF2D78</SolidColorBrush>
      <CornerRadius x:Key="MlRadiusCard">12</CornerRadius>
      <CornerRadius x:Key="MlRadiusControl">8</CornerRadius>
      <CornerRadius x:Key="MlRadiusChip">4</CornerRadius>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- ── panels & cards ─────────────────────────────────────────────────────────── -->
  <Style Selector="Border.ml-panel">
    <Setter Property="Background" Value="{StaticResource MlSurfacePanel}"/>
    <Setter Property="CornerRadius" Value="{StaticResource MlRadiusCard}"/>
    <Setter Property="Padding" Value="16"/>
  </Style>
  <Style Selector="Border.ml-card">
    <Setter Property="Background" Value="{StaticResource MlSurfaceCard}"/>
    <Setter Property="BorderBrush" Value="{StaticResource MlBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource MlRadiusCard}"/>
    <Setter Property="Padding" Value="14"/>
  </Style>

  <!-- ── buttons: exactly three kinds ───────────────────────────────────────────── -->
  <Style Selector="Button.ml-primary">
    <Setter Property="Background" Value="{StaticResource MlPrimary}"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="16,9"/>
    <Setter Property="CornerRadius" Value="{StaticResource MlRadiusControl}"/>
  </Style>
  <Style Selector="Button.ml-primary.ml-go">
    <Setter Property="Background" Value="{StaticResource MlSuccess}"/>
  </Style>
  <Style Selector="Button.ml-secondary">
    <Setter Property="Background" Value="{StaticResource MlSurfaceControl}"/>
    <Setter Property="Foreground" Value="{StaticResource MlTextBody}"/>
    <Setter Property="Padding" Value="14,8"/>
    <Setter Property="CornerRadius" Value="{StaticResource MlRadiusControl}"/>
  </Style>
  <Style Selector="Button.ml-ghost">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{StaticResource MlTextMuted}"/>
    <Setter Property="Padding" Value="10,6"/>
    <Setter Property="CornerRadius" Value="{StaticResource MlRadiusControl}"/>
  </Style>

  <!-- ── chips: one anatomy, semantic variants ──────────────────────────────────── -->
  <Style Selector="Border.ml-chip">
    <Setter Property="Background" Value="{StaticResource MlSurfaceControl}"/>
    <Setter Property="CornerRadius" Value="{StaticResource MlRadiusChip}"/>
    <Setter Property="Padding" Value="7,3"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Border.ml-chip > TextBlock">
    <Setter Property="FontSize" Value="10"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Foreground" Value="White"/>
  </Style>
  <Style Selector="Border.ml-chip.ml-success"><Setter Property="Background" Value="{StaticResource MlSuccess}"/></Style>
  <Style Selector="Border.ml-chip.ml-warn"><Setter Property="Background" Value="{StaticResource MlWarn}"/></Style>
  <Style Selector="Border.ml-chip.ml-danger"><Setter Property="Background" Value="{StaticResource MlDanger}"/></Style>
  <Style Selector="Border.ml-chip.ml-info"><Setter Property="Background" Value="{StaticResource MlPrimary}"/></Style>
  <Style Selector="Border.ml-chip.ml-gold"><Setter Property="Background" Value="{StaticResource MlGold}"/></Style>

  <!-- ── grade badge: THE way a rating is shown (stars, never a letter or a number) ─ -->
  <Style Selector="Border.ml-grade">
    <Setter Property="Background" Value="{StaticResource MlSurfaceControl}"/>
    <Setter Property="CornerRadius" Value="{StaticResource MlRadiusChip}"/>
    <Setter Property="Padding" Value="8,2"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Border.ml-grade > TextBlock">
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="Bold"/>
  </Style>

  <!-- ── type scale: five sizes, not twenty ─────────────────────────────────────── -->
  <Style Selector="TextBlock.ml-h1">
    <Setter Property="FontSize" Value="26"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Foreground" Value="{StaticResource MlTextHeading}"/>
  </Style>
  <Style Selector="TextBlock.ml-h2">
    <Setter Property="FontSize" Value="17"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource MlTextHeading}"/>
  </Style>
  <Style Selector="TextBlock.ml-body">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{StaticResource MlTextBody}"/>
  </Style>
  <Style Selector="TextBlock.ml-muted">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Foreground" Value="{StaticResource MlTextMuted}"/>
  </Style>
  <Style Selector="TextBlock.ml-label">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Foreground" Value="{StaticResource MlTextMuted}"/>
  </Style>

  <!-- ── empty state: the one voice for "nothing here yet" ──────────────────────── -->
  <Style Selector="TextBlock.ml-empty">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{StaticResource MlTextMuted}"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="Margin" Value="0,18"/>
  </Style>

  <!-- ── DataGrid (P5): headers that fit, selection on-palette ──────────────────── -->
  <!-- The Fluent defaults pad headers so wide that fixed-width columns clip to
       gibberish ("Mora", "Ra"), and paint selection in stock accent blue. -->
  <Style Selector="DataGridColumnHeader">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Foreground" Value="{StaticResource MlTextMuted}"/>
    <!-- Asymmetric on purpose. The Fluent header template lays out a sort-arrow slot and a
         resize gripper to the RIGHT of the content whether or not the column is sorted, so a
         symmetric padding loses those pixels off the end of the word: "Age" rendered as "Ag",
         "Rating" with the g sliced down the middle, on every grid in the app. Giving the right
         side back its 4px is what makes a three-letter header fit a narrow column. -->
    <Setter Property="Padding" Value="6,4,2,4"/>
    <Setter Property="MinHeight" Value="30"/>
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <!-- A header that still cannot fit says so on hover rather than lying by truncation. -->
  <Style Selector="DataGridColumnHeader /template/ ContentPresenter">
    <Setter Property="TextBlock.TextTrimming" Value="CharacterEllipsis"/>
  </Style>
  <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
    <Setter Property="Fill" Value="{StaticResource MlPrimary}"/>
    <Setter Property="Opacity" Value="0.28"/>
  </Style>
  <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
    <Setter Property="Fill" Value="#22FFFFFF"/>
  </Style>

  <!-- ── placeholders read as placeholders ────────────────────────────── -->
  <!-- The Fluent default paints a TextBox watermark at nearly the same weight as a real
       value, so on Settings the empty recordings folder showed "C:\Users\you\Videos" looking
       exactly as typed-in as the Steam path above it. A hint you cannot tell from an entry is
       worse than no hint. Same treatment for a ComboBox that has nothing selected. -->
  <Style Selector="TextBox /template/ TextBlock#PART_Watermark">
    <Setter Property="Foreground" Value="{StaticResource MlTextMuted}"/>
    <Setter Property="Opacity" Value="0.72"/>
    <Setter Property="FontStyle" Value="Italic"/>
  </Style>
  <Style Selector="ComboBox /template/ TextBlock#PlaceholderTextBlock">
    <Setter Property="Foreground" Value="{StaticResource MlTextMuted}"/>
    <Setter Property="Opacity" Value="0.72"/>
    <Setter Property="FontStyle" Value="Italic"/>
  </Style>

  <!-- ── context menus (P9): the shared right-click vocabulary ─────────────────── -->
  <!-- Built in code by EntityActions; these styles are the one place their chrome
       is defined. Card surface, control radius, ghost-row hover — no new species. -->
  <Style Selector="ContextMenu">
    <Setter Property="Background" Value="{StaticResource MlSurfaceCard}"/>
    <Setter Property="BorderBrush" Value="{StaticResource MlBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="4"/>
  </Style>
  <Style Selector="ContextMenu MenuItem">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{StaticResource MlTextBody}"/>
    <Setter Property="Padding" Value="10,6"/>
    <Setter Property="CornerRadius" Value="6"/>
  </Style>
  <Style Selector="ContextMenu MenuItem:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="#22FFFFFF"/>
  </Style>
  <Style Selector="ContextMenu MenuItem:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="#22FFFFFF"/>
  </Style>
  <Style Selector="ContextMenu MenuItem:disabled">
    <Setter Property="Foreground" Value="{StaticResource MlTextMuted}"/>
  </Style>
  <Style Selector="ContextMenu Separator">
    <Setter Property="Background" Value="{StaticResource MlBorder}"/>
    <Setter Property="Height" Value="1"/>
    <Setter Property="Margin" Value="6,4"/>
  </Style>
</Styles>
