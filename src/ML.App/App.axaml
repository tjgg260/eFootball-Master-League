<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ML.App.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <!-- skin tokens (Settings → UI style); Theme.Apply swaps these at runtime -->
    <SolidColorBrush x:Key="ThemeBgBrush" Color="#0E1116"/>
    <SolidColorBrush x:Key="ThemePanelBrush" Color="#171C24"/>
    <SolidColorBrush x:Key="ThemePanelAltBrush" Color="#12161C"/>
    <SolidColorBrush x:Key="ThemeAccentBrush" Color="#1F9D4D"/>
    <SolidColorBrush x:Key="ThemeNavHoverBrush" Color="#1E2530"/>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <!-- THE design system (tokens + ml-* classes) — every new/touched element uses these -->
    <StyleInclude Source="avares://ML.App/Styles/Theme.axaml" />

    <!-- shared app chrome: tiles, panels and nav — app-wide so UserControls pick them up -->
    <Style Selector="Border.tile">
      <Setter Property="Background" Value="{DynamicResource ThemePanelBrush}"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="18"/>
      <Setter Property="Margin" Value="0,0,14,14"/>
      <Setter Property="Width" Value="210"/>
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="{DynamicResource ThemePanelBrush}"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="18"/>
    </Style>
    <Style Selector="TextBlock.tileLabel">
      <Setter Property="Foreground" Value="#7C8698"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="TextBlock.tileBig">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="24"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>
    <Style Selector="TextBlock.panelHead">
      <Setter Property="Foreground" Value="#7C8698"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
    <!-- Row height is a budget, not a taste: 16 rows + 4 section heads + the club block + Settings
         have to fit the default 820px window. At 14,10 / 14px they needed ~745px of the ~565 the
         scroller gets, so History was cut at the fold and the whole WORLD group (Market, Scouting,
         News) sat below it behind a scrollbar that hides itself. -->
    <Style Selector="Button.nav">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#C7CEDA"/>
      <Setter Property="Padding" Value="14,6"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ThemeNavHoverBrush}"/>
    </Style>
    <!-- the page you are ON (P5): tinted row + bold — "where am I" at a glance -->
    <Style Selector="Button.nav.active /template/ ContentPresenter">
      <Setter Property="Background" Value="#1E2D7DD2"/>
    </Style>
    <Style Selector="Button.nav.active">
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>
  </Application.Styles>
</Application>
