<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ML.App.ViewModels"
             xmlns:app="using:ML.App"
             x:Class="ML.App.Views.TrainingView"
             x:DataType="vm:TrainingViewModel">
  <DockPanel Margin="20">
    <TextBlock DockPanel.Dock="Top" Classes="ml-h1" Text="Training Ground" Margin="0,0,0,8"/>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
      <TextBlock Classes="ml-label" Text="FOCUS" VerticalAlignment="Center"/>
      <!-- The SKILL box next to it has always prompted; this one opened blank, so the first
           control on the screen read as a broken empty field rather than a question. -->
      <ComboBox ItemsSource="{Binding FocusOptions}" SelectedItem="{Binding SelectedFocus}"
                Width="200" MaxDropDownHeight="380"
                PlaceholderText="What should he work on?"/>
      <Button Content="Assign to selected player" Command="{Binding AssignCommand}"
              Classes="ml-primary ml-go"/>
      <TextBlock Classes="ml-label" Text="SKILL" VerticalAlignment="Center" Margin="18,0,0,0"/>
      <ComboBox ItemsSource="{Binding LearnableSkills}" SelectedItem="{Binding SelectedSkill}"
                Width="180" MaxDropDownHeight="380"
                PlaceholderText="What can he learn?"/>
      <Button Content="Start skill training" Command="{Binding StartSkillCommand}"
              Classes="ml-primary"/>
    </StackPanel>
    <TextBlock DockPanel.Dock="Top" Classes="ml-muted" Text="{Binding SkillNote}"
               Margin="0,0,0,8" TextWrapping="Wrap"/>
    <Border DockPanel.Dock="Top" Classes="ml-panel" Margin="0,0,0,10" IsVisible="{Binding HasSkillWork}">
      <StackPanel>
        <TextBlock Classes="ml-label" Text="ON THE TRAINING PITCH" Margin="0,0,0,6"/>
        <!-- Each line is a control, not a caption: click it to jump to his row, ✕ to call it off. -->
        <ItemsControl x:Name="SkillWorkList" ItemsSource="{Binding SkillWork}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SkillProgressRow">
              <Grid ColumnDefinitions="*,Auto" Margin="0,1">
                <Button Grid.Column="0" Classes="ml-ghost" Content="{Binding Line}" FontSize="12"
                        Padding="4,3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        ToolTip.Tip="Show him on the training list"
                        CommandParameter="{Binding}"
                        Command="{Binding $parent[ItemsControl].((vm:TrainingViewModel)DataContext).FocusSkillPlayerCommand}"/>
                <Button Grid.Column="1" Classes="ml-ghost" Content="✕" FontSize="11" Padding="8,3"
                        ToolTip.Tip="Call this skill work off — the half-learned work is not banked"
                        CommandParameter="{Binding}"
                        Command="{Binding $parent[ItemsControl].((vm:TrainingViewModel)DataContext).CancelSkillCommand}"/>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Foreground="#9FE6B4"
               FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"/>
    <Panel>
      <DataGrid x:Name="TrainingGrid" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}"
                IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                FrozenColumnCount="1">
        <DataGrid.Columns>
          <!-- the visible half of the row-actions ruling: the SAME menu the right-click opens.
               First column, not last: a DataGrid clips from the right, and FrozenColumnCount
               keeps it on screen through a horizontal scroll too (see SquadView's note). -->
          <DataGridTemplateColumn Header="" Width="36">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:TrainingRow">
                <Button Content="⋯" Classes="ml-ghost" FontSize="15" Padding="8,0"
                        Click="OnRowMenu" HorizontalAlignment="Center" VerticalAlignment="Center"
                        ToolTip.Tip="Everything you can do with him — right-clicking his row does the same"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Name" Width="*">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:TrainingRow">
                <TextBlock Text="{Binding Name}" ToolTip.Tip="{Binding Who}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" Margin="8,0"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Pos" Binding="{Binding Position}" Width="100"/>
          <DataGridTextColumn Header="Age" Binding="{Binding Age}" Width="71"/>
          <DataGridTemplateColumn Header="Rating" Width="78">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:TrainingRow">
                <TextBlock Text="{Binding Grade}" Foreground="{Binding RatingBrush}"
                           FontWeight="Bold" VerticalAlignment="Center" Margin="8,0"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Personality" Binding="{Binding Personality}" Width="176"/>
          <!-- "Det" was a column of three letters over a bare number. The word is what the rest of
               the screen already says in its tooltips and status lines. -->
          <DataGridTextColumn Header="Determination" Binding="{Binding Determination}" Width="141"/>
          <DataGridTextColumn Header="Focus" Binding="{Binding Focus}" Width="120"/>
          <DataGridTextColumn Header="Progress" Binding="{Binding Progress}" Width="106"/>
          <DataGridTemplateColumn Header="Skills" Width="220">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:TrainingRow">
                <TextBlock Text="{Binding Skills}" ToolTip.Tip="{Binding SkillsTip}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" Margin="8,0"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
      <!-- empty state: no squad, no roster to train -->
      <TextBlock Classes="ml-muted" Text="No players to train — the roster fills once you have a squad."
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsVisible="{Binding !Rows.Count}"/>
    </Panel>
  </DockPanel>
</UserControl>
