<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ML.App.ViewModels"
             xmlns:app="using:ML.App"
             x:Class="ML.App.Views.StatsView"
             x:DataType="vm:StatsViewModel">
  <ScrollViewer Padding="20" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="16">
      <!-- the one line this screen talks on: results of right-click verbs, verbatim -->
      <TextBlock Text="{Binding Status}" Foreground="#9FE6B4" FontSize="12" TextWrapping="Wrap"
                 IsVisible="{Binding !!Status.Length}"/>
      <Grid ColumnDefinitions="*,*,*">
        <Border Grid.Column="0" Classes="ml-panel" Margin="0,0,8,0"><StackPanel>
          <TextBlock Classes="ml-label" Text="⚽ Top scorers" Margin="0,0,0,10"/>
          <TextBlock Text="{Binding ScorersNote}" Classes="ml-muted" TextWrapping="Wrap"
                     IsVisible="{Binding !TopScorers.Count}"/>
          <DataGrid x:Name="ScorersGrid" ItemsSource="{Binding TopScorers}" IsReadOnly="True"
                    HeadersVisibility="None"
                    Height="320" IsVisible="{Binding !!TopScorers.Count}">
            <DataGrid.Columns>
              <DataGridTemplateColumn Width="36">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:ScorerRow">
                    <Border Width="26" Height="26" CornerRadius="13" ClipToBounds="True" Margin="4,2">
                      <Image Source="{Binding Portrait}" Width="26" Height="26" Stretch="UniformToFill"/>
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Binding="{Binding Player}" Width="*"/>
              <DataGridTextColumn Binding="{Binding Team}" Width="100"/>
              <DataGridTextColumn Binding="{Binding Goals}" Width="40"/>
              <DataGridTextColumn Binding="{Binding Rate}" Width="86"/>
            </DataGrid.Columns></DataGrid></StackPanel></Border>
        <Border Grid.Column="1" Classes="ml-panel" Margin="4,0,4,0"><StackPanel>
          <TextBlock Classes="ml-label" Text="🅰 Top assists" Margin="0,0,0,10"/>
          <TextBlock Text="Assists appear here as matches are played." Classes="ml-muted"
                     TextWrapping="Wrap" IsVisible="{Binding !TopAssists.Count}"/>
          <DataGrid x:Name="AssistsGrid" ItemsSource="{Binding TopAssists}" IsReadOnly="True"
                    HeadersVisibility="None"
                    Height="320" IsVisible="{Binding !!TopAssists.Count}">
            <DataGrid.Columns>
              <DataGridTemplateColumn Width="36">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:ScorerRow">
                    <Border Width="26" Height="26" CornerRadius="13" ClipToBounds="True" Margin="4,2">
                      <Image Source="{Binding Portrait}" Width="26" Height="26" Stretch="UniformToFill"/>
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Binding="{Binding Player}" Width="*"/>
              <DataGridTextColumn Binding="{Binding Team}" Width="110"/>
              <DataGridTextColumn Binding="{Binding Goals}" Width="44"/>
            </DataGrid.Columns></DataGrid></StackPanel></Border>
        <Border Grid.Column="2" Classes="ml-panel" Margin="8,0,0,0"><StackPanel>
          <TextBlock Classes="ml-label" Text="Best defence (goals against)" Margin="0,0,0,10"/>
          <TextBlock Text="Rankings appear once league matches have been played." Classes="ml-muted"
                     TextWrapping="Wrap" IsVisible="{Binding !BestDefence.Count}"/>
          <DataGrid x:Name="DefenceGrid" ItemsSource="{Binding BestDefence}" IsReadOnly="True"
                    HeadersVisibility="None"
                    Height="320" IsVisible="{Binding !!BestDefence.Count}">
            <DataGrid.Columns>
              <DataGridTemplateColumn Width="32">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:StatRow">
                    <Image Source="{Binding Crest}" Width="20" Height="20" Margin="4,2"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Binding="{Binding Team}" Width="*"/>
              <DataGridTextColumn Binding="{Binding Value}" Width="60"/>
            </DataGrid.Columns></DataGrid></StackPanel></Border>
      </Grid>
      <Grid ColumnDefinitions="*,*,*">
        <Border Grid.Column="0" Classes="ml-panel" Margin="0,0,8,0" IsVisible="{Binding HasCleanSheets}"><StackPanel>
          <TextBlock Classes="ml-label" Text="🧤 Clean sheets" Margin="0,0,0,10"/>
          <DataGrid x:Name="CleanSheetGrid" ItemsSource="{Binding CleanSheets}" IsReadOnly="True"
                    HeadersVisibility="None" MaxHeight="240">
            <DataGrid.Columns>
              <DataGridTemplateColumn Width="32">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:StatRow">
                    <Image Source="{Binding Crest}" Width="20" Height="20" Margin="4,2"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Binding="{Binding Team}" Width="*"/>
              <DataGridTextColumn Binding="{Binding Value}" Width="50"/>
            </DataGrid.Columns></DataGrid></StackPanel></Border>
        <Border Grid.Column="1" Classes="ml-panel" Margin="4,0,4,0" IsVisible="{Binding HasDiscipline}"><StackPanel>
          <TextBlock Classes="ml-label" Text="🟨 Discipline" Margin="0,0,0,10"/>
          <DataGrid x:Name="DisciplineGrid" ItemsSource="{Binding Discipline}" IsReadOnly="True"
                    HeadersVisibility="None" MaxHeight="240">
            <DataGrid.Columns>
              <DataGridTemplateColumn Width="36">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:CardRow">
                    <Border Width="26" Height="26" CornerRadius="13" ClipToBounds="True" Margin="4,2">
                      <Image Source="{Binding Portrait}" Width="26" Height="26" Stretch="UniformToFill"/>
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Binding="{Binding Player}" Width="*"/>
              <DataGridTextColumn Binding="{Binding Team}" Width="100"/>
              <DataGridTextColumn Binding="{Binding Cards}" Width="80"/>
            </DataGrid.Columns></DataGrid></StackPanel></Border>
        <Border Grid.Column="2" Classes="ml-panel" Margin="8,0,0,0" IsVisible="{Binding HasHeadToHead}"><StackPanel>
          <TextBlock Classes="ml-label" Text="⚔ Head to head" Margin="0,0,0,10"/>
          <TextBlock Text="{Binding HeadToHeadLine}" Classes="ml-body"
                     TextWrapping="Wrap" Margin="0,6,0,0"/>
          <!-- the opponent is a club, so it is one click from being one -->
          <Button Classes="ml-ghost" Content="{Binding OpponentButton}" Margin="0,10,0,0"
                  HorizontalAlignment="Left" Command="{Binding ViewOpponentCommand}"/>
        </StackPanel></Border>
      </Grid>
      <Border Classes="ml-panel"><StackPanel>
        <TextBlock Classes="ml-label" Text="📊 Match reports" Margin="0,0,0,10"/>
        <TextBlock Text="Match reports are filed here after every game you play." Classes="ml-muted"
                   IsVisible="{Binding !MatchReports.Count}"/>
        <ItemsControl x:Name="ReportsList" ItemsSource="{Binding MatchReports}">
          <ItemsControl.ItemTemplate>
            <!-- a filed report opens the whole match: every counter the stats host kept -->
            <DataTemplate x:DataType="vm:ReportRow">
              <Button Classes="ml-ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                      Padding="6,3" ToolTip.Tip="Open the match report"
                      Command="{Binding $parent[ItemsControl].((vm:StatsViewModel)DataContext).OpenReportCommand}"
                      CommandParameter="{Binding}">
                <Grid ColumnDefinitions="70,*,Auto">
                  <TextBlock Text="{Binding When}" Classes="ml-muted"/>
                  <TextBlock Grid.Column="1" Text="{Binding Line}" Classes="ml-body"/>
                  <TextBlock Grid.Column="2" Text="{Binding Stats}" Foreground="#9FE6B4" FontSize="12"/>
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel></Border>
      <Border Classes="ml-panel"><StackPanel>
        <TextBlock Classes="ml-label" Text="🏆 Roll of Honour" Margin="0,0,0,10"/>
        <TextBlock Text="{Binding HonoursNote}" Classes="ml-muted"
                   IsVisible="{Binding !Honours.Count}"/>
        <ItemsControl x:Name="HonoursList" ItemsSource="{Binding Honours}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:HonourRow">
              <Grid ColumnDefinitions="70,*,26,*" Margin="0,3">
                <TextBlock Grid.Column="0" Text="{Binding Year}" Classes="ml-body"
                           Foreground="{DynamicResource MlTextMuted}"/>
                <TextBlock Grid.Column="1" Text="{Binding Competition}" Classes="ml-body"/>
                <Border Grid.Column="2" Width="20" Height="20" CornerRadius="10" ClipToBounds="True">
                  <Image Source="{Binding Crest}" Width="20" Height="20" Stretch="UniformToFill"/>
                </Border>
                <TextBlock Grid.Column="3" Text="{Binding Team}" Classes="ml-body"
                           Foreground="{DynamicResource MlTextHeading}" FontWeight="SemiBold"
                           Margin="6,0,0,0"/>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel></Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
