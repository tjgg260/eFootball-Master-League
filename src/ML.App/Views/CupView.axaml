<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ML.App.ViewModels"
             xmlns:app="using:ML.App"
             x:Class="ML.App.Views.CupView"
             x:DataType="vm:CupViewModel">
  <DockPanel Margin="20">
    <!-- verb results from a tie's right-click menu, verbatim -->
    <TextBlock DockPanel.Dock="Top" Text="{Binding StatusLine}" Foreground="#9FE6B4" FontSize="12"
               TextWrapping="Wrap" Margin="0,0,0,10" IsVisible="{Binding !!StatusLine.Length}"/>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <ItemsControl x:Name="CupSections" ItemsSource="{Binding Sections}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:CupSection">
          <StackPanel Spacing="14" Margin="0,0,0,26">
            <TextBlock Classes="ml-h1" Text="{Binding Header}"/>
            <TextBlock Classes="ml-body" Text="{Binding Status}" Foreground="#9FE6B4"/>
            <!-- empty state (cup before the draw): no silent void where a bracket should be -->
            <TextBlock Classes="ml-muted" IsVisible="{Binding !Rounds.Count}"
                       Text="The bracket appears here once the draw is made."/>
            <!-- the BRACKET (P6): rounds as columns, ties centred — read left to right -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding Rounds}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="14"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CupRound">
                    <Border Classes="ml-panel" Width="230" VerticalAlignment="Stretch">
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Classes="ml-label" Margin="0,0,0,8"
                                   Text="{Binding Name}"/>
                        <ItemsControl ItemsSource="{Binding Ties}" VerticalAlignment="Center">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CupTie">
                              <!-- Bg is the your-tie highlight — semantic, stays a binding -->
                              <Border CornerRadius="8" Padding="9,6" Margin="0,3"
                                      Background="{Binding Bg}"
                                      BorderBrush="{DynamicResource MlBorder}"
                                      BorderThickness="1">
                                <StackPanel Spacing="1">
                                  <Grid ColumnDefinitions="18,*,Auto">
                                    <Image Source="{Binding HomeCrest}" Width="14" Height="14"
                                           VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Home}"
                                               Foreground="{DynamicResource MlTextHeading}"
                                               FontSize="12" FontWeight="SemiBold" Margin="3,0,0,0"
                                               TextTrimming="CharacterEllipsis"/>
                                    <!-- the visible half of the row-actions ruling: the SAME
                                         menu the right-click on the card opens -->
                                    <Button Grid.Column="2" Content="⋯" Classes="ml-ghost"
                                            FontSize="11" Padding="4,0" Click="OnTieMenu"
                                            VerticalAlignment="Center"
                                            ToolTip.Tip="Everything you can do about this tie — right-clicking it does the same"/>
                                  </Grid>
                                  <Grid ColumnDefinitions="18,*,Auto">
                                    <Image Source="{Binding AwayCrest}" Width="14" Height="14"
                                           VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Away}"
                                               Foreground="{DynamicResource MlTextBody}"
                                               FontSize="12" Margin="3,0,0,0"
                                               TextTrimming="CharacterEllipsis"/>
                                    <!-- played: the score speaks in gold -->
                                    <TextBlock Grid.Column="2" Text="{Binding Score}"
                                               IsVisible="{Binding Played}"
                                               Foreground="{DynamicResource MlGold}" FontWeight="Bold"
                                               FontSize="11" Margin="8,0,0,0"/>
                                    <!-- unplayed: the "v" murmurs -->
                                    <TextBlock Grid.Column="2" Text="{Binding Score}"
                                               IsVisible="{Binding !Played}"
                                               Foreground="{DynamicResource MlTextMuted}"
                                               FontSize="11" Margin="8,0,0,0"/>
                                  </Grid>
                                </StackPanel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </DockPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
