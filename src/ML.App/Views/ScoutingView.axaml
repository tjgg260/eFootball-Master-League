<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ML.App.ViewModels"
             xmlns:app="using:ML.App"
             x:Class="ML.App.Views.ScoutingView"
             x:DataType="vm:ScoutingViewModel">
  <DockPanel Margin="20">
    <TextBlock DockPanel.Dock="Top" Text="Scouting" Classes="ml-h1" Margin="0,0,0,4"/>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="14" Margin="0,0,0,10">
      <TextBlock Text="{Binding ScoutLine}" Classes="ml-body"/>
      <TextBlock Text="{Binding MissionLine}" Classes="ml-body" Foreground="{StaticResource MlWarn}"/>
    </StackPanel>
    <!-- each Scout button sits beside its own picker -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,24,Auto,Auto" Margin="0,0,0,10">
      <ComboBox Grid.Column="0" ItemsSource="{Binding Clubs}" SelectedItem="{Binding SelectedClub}"
                Width="220" MaxDropDownHeight="380">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ScoutTargetClub">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <!-- fixed-size slot keeps names aligned when a club has no crest art -->
              <Image Source="{Binding Crest}" Width="16" Height="16" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
            </StackPanel>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <Button Grid.Column="1" Content="🔍 Scout club" Command="{Binding ScoutClubCommand}"
              Margin="8,0,0,0" Classes="ml-primary"/>
      <TextBox Grid.Column="3" Watermark="…or a player name" Text="{Binding PlayerSearch}"
               Width="240"/>
      <Button Grid.Column="4" Content="🔍 Scout player" Command="{Binding ScoutPlayerCommand}"
              Margin="8,0,0,0" Classes="ml-primary"/>
    </Grid>
    <TextBlock DockPanel.Dock="Top" Text="{Binding Status}" Foreground="#9FE6B4" FontSize="12"
               TextWrapping="Wrap" Margin="0,0,0,8"/>
    <TextBlock DockPanel.Dock="Top" Classes="ml-muted" IsVisible="{Binding Empty}"
               Text="No dossiers yet — send the scout out; reports take two matchdays."/>
    <ScrollViewer>
      <ItemsControl ItemsSource="{Binding Reports}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ScoutReportRow">
            <Border Classes="ml-card" Margin="0,0,0,10">
              <StackPanel>
                <!-- the dossier's subject gets its face: club crest, or the player's portrait
                     when one resolves (no portrait -> just the name, no placeholder) -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Image Source="{Binding Crest}" Width="20" Height="20"
                         VerticalAlignment="Center" IsVisible="{Binding HasCrest}"/>
                  <Border Width="24" Height="24" CornerRadius="12" ClipToBounds="True"
                          VerticalAlignment="Center" IsVisible="{Binding HasFace}">
                    <Image Source="{Binding Face}" Stretch="UniformToFill"/>
                  </Border>
                  <TextBlock Text="{Binding Title}" Classes="ml-h2" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{Binding Body}" Classes="ml-body"
                           TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="19"/>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
