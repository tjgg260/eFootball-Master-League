<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ML.App.ViewModels"
             xmlns:app="using:ML.App"
             x:Class="ML.App.Views.InboxView"
             x:DataType="vm:InboxViewModel">
  <DockPanel Margin="20">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
      <TextBlock Classes="ml-h1" Text="{Binding Header}"/>
      <Button Grid.Column="1" Classes="ml-secondary" Content="Mark all read"
              Command="{Binding MarkAllReadCommand}" FontSize="12" VerticalAlignment="Center"/>
    </Grid>
    <TextBlock DockPanel.Dock="Top" Classes="ml-muted" IsVisible="{Binding Empty}"
               Text="Nothing on the wire yet — play a match and the news will follow."/>

    <!-- ticker rail: AROUND THE MARKET with faces (Sky-style) -->
    <Border DockPanel.Dock="Right" Classes="ml-panel" Width="250" Margin="14,0,0,0"
            IsVisible="{Binding HasTicker}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Classes="ml-label" Text="AROUND THE MARKET"
                   LetterSpacing="1.4" Margin="0,0,0,10"/>
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding Ticker}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:TickerEntry">
                <Grid ColumnDefinitions="40,*" Margin="0,4">
                  <Border Width="32" Height="32" CornerRadius="16" ClipToBounds="True"
                          Background="{StaticResource MlSurfaceControl}">
                    <Panel>
                      <TextBlock Text="{Binding Mark}" Foreground="{StaticResource MlTextMuted}"
                                 FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>
                      <Image Source="{Binding Portrait}" Stretch="UniformToFill"
                             IsVisible="{Binding HasPortrait}"/>
                    </Panel>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Player}" Foreground="{StaticResource MlTextHeading}"
                               FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Line}" Foreground="{StaticResource MlWarn}" FontSize="10"/>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <ScrollViewer>
      <StackPanel>
        <!-- DONE DEAL hero: the latest paid move, Sky-style (bespoke moment — gradient stays) -->
        <Border CornerRadius="14" Padding="18" Margin="0,0,0,14" IsVisible="{Binding HeroVisible}"
                BorderBrush="{StaticResource MlSuccess}" BorderThickness="1">
          <Border.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
              <GradientStop Color="#0E2A1C" Offset="0"/>
              <GradientStop Color="#10151D" Offset="0.7"/>
            </LinearGradientBrush>
          </Border.Background>
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Border Width="76" Height="76" CornerRadius="38" ClipToBounds="True"
                    Background="{StaticResource MlSurfaceControl}"
                    BorderBrush="{StaticResource MlSuccess}" BorderThickness="2">
              <Panel>
                <TextBlock Text="⚽" FontSize="26" HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                <Image Source="{Binding HeroPortrait}" Stretch="UniformToFill"
                       IsVisible="{Binding HasHeroPortrait}"/>
              </Panel>
            </Border>
            <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center" Spacing="2">
              <Border Classes="ml-chip ml-success" HorizontalAlignment="Left">
                <TextBlock Text="✓ DONE DEAL" LetterSpacing="1.5"/>
              </Border>
              <TextBlock Text="{Binding HeroName}" Foreground="{StaticResource MlTextHeading}"
                         FontSize="22" FontWeight="Bold"/>
              <TextBlock Text="{Binding HeroLine}" Foreground="{StaticResource MlTextMuted}"
                         FontSize="13"/>
            </StackPanel>
            <TextBlock Grid.Column="2" Text="{Binding HeroFee}" Foreground="{StaticResource MlGold}"
                       FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
          </Grid>
        </Border>

        <!-- the feed: accent-barred cards with faces; click a message to mark it read (P6) -->
        <ItemsControl ItemsSource="{Binding Rows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:NewsEntry">
              <Button Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,10"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                      Cursor="Hand"
                      Command="{Binding $parent[ItemsControl].((vm:InboxViewModel)DataContext).MarkReadCommand}"
                      CommandParameter="{Binding}">
                <Border Classes="ml-card" BorderThickness="3,0,0,0"
                        BorderBrush="{Binding AccentBrush}">
                  <Grid ColumnDefinitions="Auto,*">
                    <Border Width="44" Height="44" CornerRadius="22" ClipToBounds="True"
                            Background="{StaticResource MlSurfaceControl}" VerticalAlignment="Top"
                            Margin="0,2,12,0">
                      <Panel>
                        <TextBlock Text="{Binding Icon}" FontSize="17" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        <!-- club crest fills the avatar slot when the story has no player face -->
                        <Image Source="{Binding Crest}" Stretch="Uniform" Margin="7"
                               IsVisible="{Binding HasCrest}"/>
                        <Image Source="{Binding Portrait}" Stretch="UniformToFill"
                               IsVisible="{Binding HasPortrait}"/>
                      </Panel>
                    </Border>
                    <StackPanel Grid.Column="1">
                      <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                        <!-- unread dot (P6): bold subject + dot; read rows go muted -->
                        <Ellipse Width="8" Height="8" Fill="{StaticResource MlPrimary}"
                                 Margin="0,0,8,0" VerticalAlignment="Center"
                                 IsVisible="{Binding ShowNew}"/>
                        <!-- breaking rows: danger bar (AccentBrush) + this chip -->
                        <Border Grid.Column="1" Classes="ml-chip ml-danger" Margin="0,0,8,0"
                                IsVisible="{Binding IsBreaking}">
                          <TextBlock Text="BREAKING"/>
                        </Border>
                        <TextBlock Grid.Column="2" Text="{Binding Subject}"
                                   FontWeight="{Binding SubjectWeight}"
                                   Foreground="{Binding SubjectBrush}" FontSize="15"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="3" Text="{Binding When}" Classes="ml-muted"
                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                      </Grid>
                      <TextBlock Text="{Binding Body}" Foreground="{Binding BodyBrush}"
                                 TextWrapping="Wrap" Margin="0,5,0,0" FontSize="13"/>
                    </StackPanel>
                  </Grid>
                </Border>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
