<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ML.App.ViewModels"
             x:Class="ML.App.Views.SquadView"
             x:DataType="vm:SquadViewModel">
  <UserControl.Styles>
    <!-- roster filter chips: the active one looks pressed (P6 fix 6) -->
    <Style Selector="Button.chip">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Background" Value="{DynamicResource MlSurfaceControl}"/>
      <Setter Property="Foreground" Value="{DynamicResource MlTextBody}"/>
    </Style>
    <Style Selector="Button.chip.active">
      <Setter Property="Background" Value="{DynamicResource MlPrimary}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="*,336" Margin="20">

    <!-- roster with search + filter chips (P6 UX) -->
    <DockPanel Grid.Column="0">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,10">
        <TextBox Text="{Binding SquadSearch}" Watermark="🔎 Find a player…" Width="180"/>
        <ComboBox ItemsSource="{Binding Clubs}" SelectedItem="{Binding SelectedClub}" Width="200"
                  ToolTip.Tip="Browse any club in your leagues">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:SquadClubOption">
              <TextBlock Text="{Binding Name}"/>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Text="👁 scouting view — read-only" Classes="ml-label"
                   Foreground="{DynamicResource MlWarn}"
                   VerticalAlignment="Center" IsVisible="{Binding ViewingOtherClub}"/>
        <ItemsControl ItemsSource="{Binding FilterChips}" VerticalAlignment="Center">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="5"/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:FilterChipVm">
              <Button Content="{Binding Name}" Classes="chip" Classes.active="{Binding IsActive}"
                      Command="{Binding $parent[UserControl].((vm:SquadViewModel)DataContext).SetChipCommand}"
                      CommandParameter="{Binding}"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- players out or in on loan, with January recall (P6 fix 5: neutral header) -->
      <Border DockPanel.Dock="Bottom" IsVisible="{Binding HasLoans}"
              Classes="ml-card" Padding="12,8" Margin="0,10,0,0">
        <StackPanel Spacing="4">
          <TextBlock Text="LOANS" Classes="ml-label"/>
          <ItemsControl ItemsSource="{Binding Loans}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:LoanRowVm">
                <DockPanel Margin="0,2,0,0">
                  <Button DockPanel.Dock="Right" Content="Recall" Classes="ml-secondary"
                          FontSize="10" Padding="8,4"
                          IsVisible="{Binding IsOut}"
                          Command="{Binding $parent[UserControl].((vm:SquadViewModel)DataContext).RecallLoanCommand}"
                          CommandParameter="{Binding}"/>
                  <TextBlock Text="{Binding Line}" Classes="ml-body" FontSize="12"
                             VerticalAlignment="Center"/>
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

    <Panel>
      <DataGrid ItemsSource="{Binding Rows}"
                SelectedItem="{Binding Selected, Mode=TwoWay}" IsReadOnly="True"
                GridLinesVisibility="Horizontal" HeadersVisibility="Column">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="" Width="52">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:SquadEntry">
                <Panel Width="38" Height="38" Margin="6,3">
                  <Border CornerRadius="19" Background="{Binding MarkBrush}">
                    <TextBlock Text="{Binding Mark}" FontSize="12" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <Border CornerRadius="19" ClipToBounds="True">
                    <Image Source="{Binding Portrait}" Width="38" Height="38" Stretch="UniformToFill"/>
                  </Border>
                </Panel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="48"/>
          <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
          <DataGridTextColumn Header="Pos" Binding="{Binding Position}" Width="66"/>
          <DataGridTextColumn Header="Playstyle" Binding="{Binding Playstyle}" Width="120"/>
          <DataGridTemplateColumn Header="Morale" Width="86">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:SquadEntry">
                <TextBlock Text="{Binding MoraleFace}" FontSize="15" VerticalAlignment="Center"
                           HorizontalAlignment="Center" ToolTip.Tip="{Binding MoraleLabel}"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Age" Binding="{Binding Age}" Width="60"/>
          <DataGridTemplateColumn Header="Rating" Width="78">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:SquadEntry">
                <TextBlock Text="{Binding Grade}" Foreground="{Binding RatingBrush}"
                           FontSize="14" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="CON" Width="62">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:SquadEntry">
                <Ellipse Width="10" Height="10" Fill="{Binding ConditionBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="" Width="36">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:SquadEntry">
                <Border Width="18" Height="18" CornerRadius="9" Background="{DynamicResource MlDanger}"
                        IsVisible="{Binding IsInjured}"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                  <TextBlock Text="+" FontSize="13" FontWeight="Bold" Foreground="White"
                             HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                </Border>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
      <!-- empty state: the filter/search can strip every row -->
      <TextBlock Classes="ml-muted" Text="No players match — clear the search or pick another chip."
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsVisible="{Binding !Rows.Count}"/>
    </Panel>
    </DockPanel>

    <!-- player card -->
    <Border Grid.Column="1" Margin="16,0,0,0" Classes="ml-panel" Padding="18">
      <Panel>
        <TextBlock Text="Select a player" Classes="ml-muted" FontSize="14"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNull}}"/>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}">
          <StackPanel Spacing="14">

            <!-- name / big rating / position tag -->
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0" Spacing="6">
                <TextBlock Text="{Binding Selected.Name}" FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource MlTextHeading}" TextWrapping="Wrap"/>
                <Border Background="{Binding Selected.MarkBrush}" CornerRadius="4" Padding="8,2"
                        HorizontalAlignment="Left">
                  <TextBlock Text="{Binding Selected.Position}" FontSize="11" FontWeight="Bold"
                             Foreground="White"/>
                </Border>
              </StackPanel>
              <TextBlock Grid.Column="1" Text="{Binding Selected.Grade}" FontSize="34" FontWeight="Bold"
                         Foreground="{Binding Selected.RatingBrush}" Margin="10,0,0,0"
                         VerticalAlignment="Top"/>
            </Grid>

            <!-- playstyle chip (brand pink — deliberately outside the semantic chip set) -->
            <Border HorizontalAlignment="Left" CornerRadius="11" Padding="12,4"
                    Background="#26FF2D78" BorderBrush="#80FF2D78" BorderThickness="1">
              <TextBlock Text="{Binding Selected.Playstyle}" FontSize="12" FontWeight="SemiBold"
                         Foreground="#FF7FAE"/>
            </Border>

            <!-- portrait -->
            <Panel Width="96" Height="96" HorizontalAlignment="Center">
              <Border Width="96" Height="96" CornerRadius="48" Background="{Binding Selected.MarkBrush}">
                <TextBlock Text="{Binding Selected.Mark}" FontSize="28" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <Border Width="96" Height="96" CornerRadius="48" ClipToBounds="True">
                <Image Source="{Binding Selected.Portrait}" Width="96" Height="96" Stretch="UniformToFill"/>
              </Border>
            </Panel>

            <!-- ══ THE MFL CARD (UX P3): four tabs, graded statements, never a number ══ -->
            <TabControl Margin="0,4,0,0" Padding="0,10,0,0">
              <TabControl.Styles>
                <Style Selector="TabItem">
                  <Setter Property="FontSize" Value="13"/>
                  <Setter Property="FontWeight" Value="Bold"/>
                  <Setter Property="Padding" Value="4,2"/>
                  <Setter Property="MinHeight" Value="30"/>
                  <Setter Property="Margin" Value="0,0,10,0"/>
                </Style>
              </TabControl.Styles>

              <TabItem Header="Info">
                <StackPanel Spacing="14" Margin="0,10,0,0">
                  <!-- hexagon ability radar; axis labels follow the player (GK axes are gk_* abilities) -->
                  <Panel Width="200" Height="200" HorizontalAlignment="Center">
                    <Canvas Width="200" Height="200">
                      <Polygon Points="100,22 167.6,61 167.6,139 100,178 32.4,139 32.4,61"
                               Stroke="#3A4759" StrokeThickness="1"/>
                      <Polygon Points="100,48 145,74 145,126 100,152 55,126 55,74"
                               Stroke="#3A4759" StrokeThickness="1"/>
                      <Polygon Points="100,74 122.5,87 122.5,113 100,126 77.5,113 77.5,87"
                               Stroke="#3A4759" StrokeThickness="1"/>
                      <!-- pinned comparison radar (dashed blue) under the live one -->
                      <Polygon Points="{Binding PinnedPoints}" Stroke="{DynamicResource MlPrimary}" StrokeThickness="2"
                               StrokeDashArray="4,3" Fill="#202D7DD2" IsVisible="{Binding HasPinned}"/>
                      <Polygon Points="{Binding RadarPoints}" Stroke="#FF2D78" StrokeThickness="2"
                               Fill="#40FF2D78" IsVisible="{Binding !RadarMasked}"/>
                      <TextBlock Canvas.Left="89" Canvas.Top="6" Text="{Binding RadarLabels[0]}" FontSize="10" Foreground="{DynamicResource MlTextMuted}"/>
                      <TextBlock Canvas.Left="174" Canvas.Top="48" Text="{Binding RadarLabels[1]}" FontSize="10" Foreground="{DynamicResource MlTextMuted}"/>
                      <TextBlock Canvas.Left="174" Canvas.Top="142" Text="{Binding RadarLabels[2]}" FontSize="10" Foreground="{DynamicResource MlTextMuted}"/>
                      <TextBlock Canvas.Left="89" Canvas.Top="183" Text="{Binding RadarLabels[3]}" FontSize="10" Foreground="{DynamicResource MlTextMuted}"/>
                      <TextBlock Canvas.Left="6" Canvas.Top="142" Text="{Binding RadarLabels[4]}" FontSize="10" Foreground="{DynamicResource MlTextMuted}"/>
                      <TextBlock Canvas.Left="6" Canvas.Top="48" Text="{Binding RadarLabels[5]}" FontSize="10" Foreground="{DynamicResource MlTextMuted}"/>
                    </Canvas>
                    <!-- knowledge gate (P6 fix 3): a barely-scouted player shows no polygon -->
                    <TextBlock Classes="ml-muted" Text="Barely scouted — send a scout to reveal his game."
                               IsVisible="{Binding RadarMasked}" TextWrapping="Wrap" TextAlignment="Center"
                               MaxWidth="130" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Panel>
                  <!-- info strip -->
                  <Border Classes="ml-card" Padding="12,10">
                    <Grid ColumnDefinitions="*,*,*">
                      <StackPanel Grid.Column="0" Spacing="2" HorizontalAlignment="Center">
                        <TextBlock Text="HEIGHT" Classes="ml-label" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Selected.HeightDisplay}" Classes="ml-body"
                                   FontWeight="SemiBold" HorizontalAlignment="Center"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Center">
                        <TextBlock Text="WEIGHT" Classes="ml-label" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Selected.WeightDisplay}" Classes="ml-body"
                                   FontWeight="SemiBold" HorizontalAlignment="Center"/>
                      </StackPanel>
                      <StackPanel Grid.Column="2" Spacing="2" HorizontalAlignment="Center">
                        <TextBlock Text="AGE" Classes="ml-label" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Selected.AgeDisplay}" Classes="ml-body"
                                   FontWeight="SemiBold" HorizontalAlignment="Center"/>
                      </StackPanel>
                    </Grid>
                  </Border>

                  <TextBlock Text="{Binding SeasonLine}" Classes="ml-body" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding CharacterLine}" FontSize="12" Foreground="#C7A8E8"/>
                  <TextBlock Text="{Binding SkillsLine}" Classes="ml-muted" TextWrapping="Wrap"/>

                  <!-- the six graded analysis panels — the north star's core feature -->
                  <ItemsControl ItemsSource="{Binding AnalysisPanels}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:SquadViewModel+AnalysisPanelVm">
                        <Border Classes="ml-card" Margin="0,0,0,10" Padding="12,10">
                          <StackPanel Spacing="6">
                            <TextBlock Text="{Binding Name}" Classes="ml-h2" FontSize="14"/>
                            <ItemsControl ItemsSource="{Binding Lines}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SquadViewModel+AnalysisLineVm">
                                  <Grid ColumnDefinitions="22,*,Auto" Margin="0,2">
                                    <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="12"
                                               FontWeight="Bold" Foreground="{Binding IconBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Text}" Classes="ml-body"
                                               FontSize="12" TextWrapping="Wrap"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Grade}" FontSize="12"
                                               FontWeight="Bold" Foreground="{Binding IconBrush}"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                  </Grid>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Classes="ml-muted" TextWrapping="Wrap"
                             Text="His game is still a mystery — scout him to unlock the analysis."
                             IsVisible="{Binding !AnalysisPanels.Count}"/>

                  <!-- ability list -->
                  <StackPanel Spacing="6">
                    <TextBlock Text="ABILITY" Classes="ml-label"/>
                    <ItemsControl ItemsSource="{Binding Abilities}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <UniformGrid Columns="2"/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:AbilityEntry">
                          <Grid ColumnDefinitions="*,Auto" Margin="0,2,14,2">
                            <TextBlock Grid.Column="0" Text="{Binding Name}" Classes="ml-body"
                                       FontSize="12" TextTrimming="CharacterEllipsis"/>
                            <Panel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Display}" FontSize="12" FontWeight="SemiBold"
                                         Foreground="{Binding ValueBrush}"/>
                              <!-- FM mode: the colour band replaces the number -->
                              <Border Width="26" Height="10" CornerRadius="3"
                                      Background="{Binding BandBrush}" IsVisible="{Binding ShowBand}"/>
                            </Panel>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>

                  <!-- permanent coach/analyst reports (P5); the FM display toggle lives in Settings -->
                  <Border Classes="ml-card" Padding="10" IsVisible="{Binding HasCoachLines}">
                    <StackPanel Spacing="2">
                      <TextBlock Text="COACH'S REPORT" Classes="ml-label" LetterSpacing="1.1"/>
                      <ItemsControl ItemsSource="{Binding CoachLines}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding}" Classes="ml-body" FontSize="12"/>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Text="{Binding AnalystLine}" Classes="ml-muted"
                                 TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                  </Border>

                  <ItemsControl ItemsSource="{Binding CareerRows}" IsVisible="{Binding HasCareerRows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{Binding}" Classes="ml-muted"/>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <WrapPanel>
                    <Button Content="📌 Compare" Command="{Binding PinCompareCommand}" Classes="ml-secondary"
                            FontSize="11" Margin="0,2,6,0"/>
                    <Button Content="✖" Command="{Binding ClearCompareCommand}" Classes="ml-ghost"
                            FontSize="11" Margin="0,2,0,0" IsVisible="{Binding HasPinned}"
                            ToolTip.Tip="Clear comparison"/>
                  </WrapPanel>
                  <TextBlock Text="{Binding PinnedName, StringFormat='Comparing against {0} (dashed blue)'}"
                             FontSize="11" Foreground="{DynamicResource MlPrimary}" IsVisible="{Binding HasPinned}"/>
                  <TextBlock Text="{Binding SquadStatus}" FontSize="11" Foreground="#9FE6B4" TextWrapping="Wrap"/>
                </StackPanel>
              </TabItem>

              <TabItem Header="Contract">
                <StackPanel Spacing="10" Margin="0,10,0,0">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding ContractLine}" Classes="ml-body"/>
                    <TextBlock Text="©" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource MlGold}"
                               IsVisible="{Binding IsCaptain}" ToolTip.Tip="Club captain"/>
                  </StackPanel>
                  <TextBlock Text="{Binding WageLine}" Classes="ml-body"/>
                  <!-- playing-time promise is a management action: own club only (P6 fix 2) -->
                  <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsOwnClub}">
                    <ComboBox ItemsSource="{Binding PtStatusOptions}"
                              SelectedItem="{Binding SelectedPtStatus}" MinWidth="180" FontSize="12"/>
                    <TextBlock Text="{Binding PlayTimeLine}" Classes="ml-muted" VerticalAlignment="Center"/>
                  </StackPanel>
                  <StackPanel IsVisible="{Binding IsOwnClub}" Spacing="8">
                    <WrapPanel>
                      <Button Content="© Captain" Command="{Binding MakeCaptainCommand}" Classes="ml-secondary" FontSize="11" Margin="0,2,6,0"/>
                      <Button Content="Renew +2yrs" Command="{Binding RenewCommand}" Classes="ml-secondary" FontSize="11" Margin="0,2,6,0"/>
                      <Button Content="🗣 Praise" Command="{Binding PraiseCommand}" Classes="ml-secondary" FontSize="11" Margin="0,2,6,0"/>
                      <Button Content="Criticise" Command="{Binding CriticiseCommand}" Classes="ml-secondary" FontSize="11" Margin="0,2,6,0"/>
                      <Button Content="Promise starts" Command="{Binding PromiseStartsCommand}" Classes="ml-secondary" FontSize="11" Margin="0,2,6,0"/>
                      <Button Content="Promise contract" Command="{Binding PromiseContractCommand}" Classes="ml-secondary" FontSize="11" Margin="0,2,0,0"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding PromiseLine}" FontSize="11" Foreground="{DynamicResource MlWarn}"/>
                    <Button Content="💬 Negotiate contract" Command="{Binding OpenNegotiationCommand}"
                            IsVisible="{Binding !Negotiating}" Classes="ml-secondary" FontSize="11"/>
                    <Border Classes="ml-card" Padding="10" IsVisible="{Binding Negotiating}">
                      <StackPanel Spacing="6">
                        <TextBlock Text="{Binding NegotiationLine}" Classes="ml-body" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="£/wk" Classes="ml-muted" VerticalAlignment="Center"/>
                          <NumericUpDown Value="{Binding WageOffer}" Minimum="500" Maximum="500000"
                                         Increment="250" FormatString="N0" Width="140"/>
                          <ComboBox ItemsSource="{Binding YearsOptions}" SelectedItem="{Binding SelectedYears}"
                                    Width="64" ToolTip.Tip="Years"/>
                          <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}"
                                    Width="110" ToolTip.Tip="Squad status promise — cheaper wage, tracked starts"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Button Content="Offer" Command="{Binding MakeOfferCommand}" Classes="ml-primary ml-go" FontSize="12"/>
                          <Button Content="Walk away" Command="{Binding CancelNegotiationCommand}" Classes="ml-secondary" FontSize="12"/>
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </StackPanel>
              </TabItem>

              <TabItem Header="Transfer">
                <StackPanel Spacing="10" Margin="0,10,0,0">
                  <Border Classes="ml-chip ml-danger" HorizontalAlignment="Left"
                          IsVisible="{Binding TransferStatusLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Text="{Binding TransferStatusLine}"/>
                  </Border>
                  <TextBlock Text="{Binding MarketValueLine}" Classes="ml-h2"/>
                  <TextBlock Text="{Binding WageLine}" Classes="ml-body"/>
                  <StackPanel IsVisible="{Binding IsOwnClub}" Spacing="8">
                    <WrapPanel>
                      <Button Content="{Binding ListLabel}" Command="{Binding ToggleListCommand}" Classes="ml-secondary" FontSize="11" Margin="0,2,6,0"/>
                      <Button Content="Loan out" Command="{Binding LoanOutCommand}" Classes="ml-secondary" FontSize="11" Margin="0,2,6,0"/>
                      <Button Content="Release" Command="{Binding ReleaseCommand}" Classes="ml-secondary" FontSize="11" Margin="0,2,0,0" Foreground="{DynamicResource MlDanger}"/>
                    </WrapPanel>
                  </StackPanel>
                </StackPanel>
              </TabItem>

              <TabItem Header="Absence">
                <StackPanel Spacing="10" Margin="0,10,0,0">
                  <TextBlock Text="{Binding AbsenceLine}" Classes="ml-body" TextWrapping="Wrap"/>
                </StackPanel>
              </TabItem>
            </TabControl>

          </StackPanel>
        </ScrollViewer>
      </Panel>
    </Border>
  </Grid>
</UserControl>
