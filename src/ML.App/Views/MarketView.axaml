<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ML.App.ViewModels"
             xmlns:app="using:ML.App"
             x:Class="ML.App.Views.MarketView"
             x:DataType="vm:MarketViewModel">
  <DockPanel Margin="20">
    <TextBlock DockPanel.Dock="Top" Text="{Binding Header}" Classes="ml-h1" Margin="0,0,0,10"/>

    <!-- offers from CPU clubs for YOUR players -->
    <Border DockPanel.Dock="Top" Classes="ml-panel" Margin="0,0,0,10" IsVisible="{Binding HasOffers}">
      <StackPanel Spacing="6">
        <TextBlock Classes="ml-label" Text="📨 Offers for your players"/>
        <ListBox ItemsSource="{Binding Offers}" SelectedItem="{Binding SelectedOffer}"
                 Background="Transparent" BorderThickness="0" MaxHeight="90">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:OfferRow">
              <TextBlock Text="{Binding Line}" Classes="ml-body"/>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Content="{Binding AcceptOfferLabel}" Command="{Binding AcceptOfferCommand}"
                  Classes="ml-primary ml-go"/>
          <Button Content="Reject" Command="{Binding RejectOfferCommand}" Classes="ml-secondary"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <TextBlock DockPanel.Dock="Top" Text="{Binding WindowLine}" Classes="ml-label"
               Foreground="{StaticResource MlWarn}" FontSize="12" Margin="0,0,0,8"/>
    <!-- filter bar: search · position · age · rating · value cap · free agents · sort -->
    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
      <WrapPanel.Styles>
        <Style Selector="WrapPanel > :is(Control)">
          <Setter Property="Margin" Value="0,0,10,8"/>
        </Style>
      </WrapPanel.Styles>
      <TextBox Watermark="Search players…" Text="{Binding SearchText}" Width="200"/>
      <ComboBox ItemsSource="{Binding Positions}" SelectedItem="{Binding PositionFilter}"
                Width="88" VerticalAlignment="Center"/>
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBlock Text="Max age" Classes="ml-muted" VerticalAlignment="Center"/>
        <NumericUpDown Value="{Binding MaxAge}" Minimum="16" Maximum="45" Increment="1"
                       FormatString="0" Width="105" VerticalAlignment="Center"/>
      </StackPanel>
      <ComboBox ItemsSource="{Binding GradeFloors}" SelectedItem="{Binding GradeFloor}"
                Width="130" VerticalAlignment="Center"
                ToolTip.Tip="Only show players of at least this calibre"/>
      <ComboBox ItemsSource="{Binding ValueCaps}" SelectedItem="{Binding ValueCap}"
                Width="110" VerticalAlignment="Center"/>
      <CheckBox Content="Free agents" IsChecked="{Binding FreeAgentsOnly}"
                Foreground="{StaticResource MlTextMuted}" FontSize="12" VerticalAlignment="Center"/>
      <!-- ⭐ the saved list: on, it shows exactly who you starred and ignores every filter above -->
      <Button Classes="ml-ghost" Padding="0" Background="Transparent" VerticalAlignment="Center"
              Command="{Binding ToggleShortlistCommand}"
              ToolTip.Tip="Show only the players on your club's shortlist">
        <Border Classes="ml-chip" Classes.ml-gold="{Binding ShortlistOnly}">
          <TextBlock Text="⭐ SHORTLIST"/>
        </Border>
      </Button>
      <!-- a club focus arriving from another screen, always visible and always removable -->
      <Button Classes="ml-ghost" Padding="0" Background="Transparent" VerticalAlignment="Center"
              Command="{Binding ClearClubFilterCommand}" IsVisible="{Binding HasClubFilter}"
              ToolTip.Tip="Clear the club filter">
        <Border Classes="ml-chip ml-info">
          <TextBlock Text="{Binding ClubFilterChip}"/>
        </Border>
      </Button>
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBlock Text="Sort" Classes="ml-muted" VerticalAlignment="Center"/>
        <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SortBy}"
                  Width="130" VerticalAlignment="Center"/>
      </StackPanel>
      <ComboBox ItemsSource="{Binding BidOptions}" SelectedItem="{Binding SelectedBid}"
                Width="145" VerticalAlignment="Center"
                ToolTip.Tip="Your offer vs market value — clubs want a premium, lowballs get countered"/>
      <Button Content="{Binding BidLabel}" Command="{Binding SignCommand}" Classes="ml-primary ml-go"
              IsEnabled="{Binding !ProfileIsMine}"/>
    </WrapPanel>
    <TextBlock DockPanel.Dock="Bottom" Text="{Binding SignStatus}" Classes="ml-body"
               Foreground="#9FE6B4" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"/>
    <Grid ColumnDefinitions="*,330">
      <Panel Grid.Column="0">
        <DataGrid x:Name="MarketGrid"
                  ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedPlayer}" IsReadOnly="True"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column" FrozenColumnCount="1">
          <DataGrid.Columns>
            <!-- the visible half of the row-actions ruling: the SAME menu the right-click opens -->
            <DataGridTemplateColumn Header="" Width="36">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:MarketPlayer">
                  <Button Content="⋯" Classes="ml-ghost" FontSize="15" Padding="8,0"
                          Click="OnRowMenu" HorizontalAlignment="Center" VerticalAlignment="Center"
                          ToolTip.Tip="Everything you can do with him — right-clicking his row does the same"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="" Width="46">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:MarketPlayer">
                  <Border Width="32" Height="32" CornerRadius="16" ClipToBounds="True"
                          Background="{Binding FaceBrush}" Margin="4,2">
                    <Panel>
                      <TextBlock Text="{Binding Mark}" Foreground="White" FontSize="9"
                                 FontWeight="Bold" HorizontalAlignment="Center"
                                 VerticalAlignment="Center" Opacity="0.85"/>
                      <Image Source="{Binding Portrait}" Stretch="UniformToFill"
                             IsVisible="{Binding HasPortrait}"/>
                    </Panel>
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
            <DataGridTextColumn Header="Pos" Binding="{Binding Position}" Width="71"/>
            <!-- The stars sharpen with what you know: a reputation window while he is
                 unscouted, a half-star window once part-scouted, the true tier when he is well
                 scouted or yours. The tooltip says which of the three you are looking at. -->
            <DataGridTemplateColumn Header="Rating" Width="78">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:MarketPlayer">
                  <TextBlock Text="{Binding Grade}" Foreground="{Binding RatingBrush}"
                             FontWeight="Bold" VerticalAlignment="Center" Margin="4,0"
                             ToolTip.Tip="{Binding GradeTip}"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Age" Binding="{Binding AgeLabel}" Width="71"/>
            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="132"/>
            <DataGridTemplateColumn Header="" Width="98">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:MarketPlayer">
                  <Panel HorizontalAlignment="Left" VerticalAlignment="Center">
                    <!-- semantic status colour stays bound; the chip anatomy comes from ml-chip -->
                    <Border Classes="ml-chip" Background="{Binding StatusBrush}"
                            IsVisible="{Binding ShowStatus}">
                      <TextBlock Text="{Binding StatusLabel}"/>
                    </Border>
                    <!-- your own man: nothing to bid for here — the right-click menu has his verbs -->
                    <Border Classes="ml-chip" IsVisible="{Binding Mine}">
                      <TextBlock Text="YOURS" Foreground="{StaticResource MlTextMuted}"/>
                    </Border>
                  </Panel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Club" Width="170">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:MarketPlayer">
                  <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                              Margin="4,0">
                    <Image Source="{Binding ClubCrest}" Width="18" Height="18" Stretch="Uniform"
                           IsVisible="{Binding HasClubCrest}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Club}" Classes="ml-body" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
        <!-- empty states (P6): a filtered-out world and a broken query are different problems -->
        <TextBlock Classes="ml-muted" Text="{Binding EmptyLine}" IsVisible="{Binding ShowEmpty}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <TextBlock Classes="ml-muted" Foreground="{StaticResource MlDanger}"
                   Text="The player search failed — see ml-crash.log next to the app."
                   IsVisible="{Binding QueryFailed}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Panel>

      <!-- the profile card: click a row, see the player -->
      <Border Grid.Column="1" Classes="ml-panel" Margin="12,0,0,0">
        <Panel>
          <TextBlock Classes="ml-muted" Text="Pick a player from the list and he appears here."
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     IsVisible="{Binding !HasProfile}"/>
          <ScrollViewer IsVisible="{Binding HasProfile}">
            <StackPanel Spacing="8">
              <!-- The way OUT of the rail, at the top where the decision is made. Double-click on
                   the row does the same thing, but a keyboard shortcut nobody is told about is
                   not an affordance — and this rail is a preview, not the profile. -->
              <Button Content="⤢ Open full profile" Command="{Binding OpenProfileCommand}"
                      Classes="ml-secondary" HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center"/>
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Border Width="64" Height="64" CornerRadius="8" ClipToBounds="True"
                        Background="{Binding ProfileFill}">
                  <Panel>
                    <TextBlock Text="{Binding ProfilePosition}" Foreground="White" FontSize="14"
                               FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Image Source="{Binding ProfilePortrait}" Stretch="UniformToFill"
                           IsVisible="{Binding ProfileHasPortrait}"/>
                  </Panel>
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding ProfilePosition}" Classes="ml-label" FontSize="13"
                               VerticalAlignment="Bottom"/>
                    <TextBlock Text="{Binding ProfileGrade}" Foreground="{Binding ProfileRatingBrush}"
                               FontSize="26" FontWeight="Bold"
                               ToolTip.Tip="{Binding ProfileGradeTip}"/>
                  </StackPanel>
                  <TextBlock Text="{Binding ProfilePlaystyle}" Classes="ml-muted"
                             Foreground="{StaticResource MlWarn}"/>
                </StackPanel>
              </StackPanel>
              <TextBlock Text="{Binding ProfileName}" Classes="ml-h2" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding ProfileBio}" Classes="ml-muted" FontSize="12"/>
              <TextBlock Text="{Binding ProfileValueLine}" Classes="ml-body"
                         Foreground="#9FE6B4" FontWeight="SemiBold"/>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Image Source="{Binding ProfileCrest}" Width="16" Height="16" Stretch="Uniform"
                       IsVisible="{Binding ProfileHasCrest}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding ProfileClub}" Classes="ml-body" FontSize="12"
                           VerticalAlignment="Center"/>
              </StackPanel>
              <TextBlock Text="{Binding ProfileKnowledgeLine}" Classes="ml-muted" FontSize="12"
                         Foreground="{StaticResource MlWarn}"/>
              <TextBlock Text="{Binding ProfileCoachLine}" Classes="ml-muted" TextWrapping="Wrap"/>
              <!-- the scout's bottom line only — the full dossier lives on the Scouting screen -->
              <TextBlock Text="{Binding ProfileVerdictLine}" Classes="ml-muted" TextWrapping="Wrap"
                         IsVisible="{Binding ProfileHasVerdict}"/>

              <!-- Hexagon radar, same maths as the Squad card — and now the same labels.
                   PlayerCard.BuildRadarPoints puts axis k at k*60-90°, so the six vertices are
                   [0] top, [1] upper-right, [2] lower-right, [3] bottom, [4] lower-left,
                   [5] upper-left. Two labels pinned to the top and bottom of the panel could only
                   ever name axis 0 and axis 3 — and the bottom one called axis 3 "DEF" when axis 3
                   is SPD. All six are bound and positioned (canvas coords copied from SquadView),
                   and they come from the ViewModel because a goalkeeper's axes are gk_* abilities
                   with an entirely different set of names. -->
              <Panel Width="200" Height="200" HorizontalAlignment="Center">
                <Ellipse Width="160" Height="160" Stroke="{StaticResource MlBorder}" StrokeThickness="1"/>
                <Ellipse Width="106" Height="106" Stroke="{StaticResource MlBorder}" StrokeThickness="1"/>
                <Ellipse Width="52" Height="52" Stroke="{StaticResource MlBorder}" StrokeThickness="1"/>
                <Polygon Points="{Binding ProfileRadar}" Fill="#402EC4A6" Stroke="#2EC4A6"
                         StrokeThickness="2"/>
                <Canvas Width="200" Height="200">
                  <TextBlock Canvas.Left="89" Canvas.Top="6" Text="{Binding RadarLabels[0]}"
                             Classes="ml-muted" FontSize="9"/>
                  <TextBlock Canvas.Left="174" Canvas.Top="48" Text="{Binding RadarLabels[1]}"
                             Classes="ml-muted" FontSize="9"/>
                  <TextBlock Canvas.Left="174" Canvas.Top="142" Text="{Binding RadarLabels[2]}"
                             Classes="ml-muted" FontSize="9"/>
                  <TextBlock Canvas.Left="89" Canvas.Top="183" Text="{Binding RadarLabels[3]}"
                             Classes="ml-muted" FontSize="9"/>
                  <TextBlock Canvas.Left="6" Canvas.Top="142" Text="{Binding RadarLabels[4]}"
                             Classes="ml-muted" FontSize="9"/>
                  <TextBlock Canvas.Left="6" Canvas.Top="48" Text="{Binding RadarLabels[5]}"
                             Classes="ml-muted" FontSize="9"/>
                </Canvas>
              </Panel>

              <!-- the action row. Your own player has no buy side: he gets a chip and his
                   real verbs come from the right-click menu. -->
              <Border Classes="ml-chip" HorizontalAlignment="Left" IsVisible="{Binding ProfileIsMine}">
                <TextBlock Text="YOURS — RIGHT-CLICK FOR SQUAD ACTIONS"
                           Foreground="{StaticResource MlTextMuted}"/>
              </Border>
              <StackPanel Spacing="8" IsVisible="{Binding !ProfileIsMine}">
                <!-- negotiation v2 (P5): open talks, structure the package, close the deal -->
                <Button Content="🤝 Open negotiation" Command="{Binding OpenTalksCommand}"
                        Classes="ml-primary ml-go" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"/>
                <Button Content="↔ Loan until June (10% of value)" Command="{Binding LoanInCommand}"
                        Classes="ml-secondary" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"/>
                <!-- the two cheap moves: look before you bid, ask before you look -->
                <Button Content="{Binding ScoutButtonLabel}" Command="{Binding SendScoutCommand}"
                        IsEnabled="{Binding CanScout}" Classes="ml-secondary" FontSize="12"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                <Button Content="💬 Enquire" Command="{Binding EnquireCommand}"
                        Classes="ml-secondary" FontSize="12"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
              </StackPanel>
              <Border Classes="ml-card" Padding="12" IsVisible="{Binding Negotiating}">
                <StackPanel Spacing="8">
                  <TextBlock Text="{Binding NegStance}" Foreground="#E7D9B8" FontSize="12"
                             FontStyle="Italic" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding NegLine}" Classes="ml-body" FontSize="12"
                             TextWrapping="Wrap"/>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Fee £" Classes="ml-muted" FontSize="12" VerticalAlignment="Center"/>
                    <NumericUpDown Value="{Binding NegFee}" Increment="100000" Minimum="0"
                                   FormatString="N0" Width="160"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <CheckBox Content="15% sell-on" IsChecked="{Binding NegSellOn}"
                              Foreground="{StaticResource MlTextBody}" FontSize="12"/>
                    <CheckBox Content="Instalments" IsChecked="{Binding NegInstalments}"
                              Foreground="{StaticResource MlTextBody}" FontSize="12"/>
                  </StackPanel>
                  <TextBlock Text="{Binding LikelihoodLine}" Classes="ml-muted" TextWrapping="Wrap"/>
                  <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !DealAgreed}">
                    <Button Content="Send offer" Command="{Binding SendOfferCommand}"
                            Classes="ml-primary ml-go" FontSize="12"/>
                    <Button Content="Walk away" Command="{Binding WalkAwayCommand}"
                            Classes="ml-secondary" Foreground="#E08A8A" FontSize="12"/>
                  </StackPanel>
                  <!-- the agent's step: wages + years, then the deal is done -->
                  <StackPanel Spacing="6" IsVisible="{Binding DealAgreed}">
                    <TextBlock Text="AGENT'S TERMS" Classes="ml-label" FontSize="10"
                               LetterSpacing="1.2"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="£/wk" Classes="ml-muted" FontSize="12" VerticalAlignment="Center"/>
                      <NumericUpDown Value="{Binding NegWage}" Increment="1000" Minimum="500"
                                     FormatString="N0" Width="130"/>
                      <ComboBox ItemsSource="{Binding YearsOptions}" SelectedItem="{Binding NegYears}"
                                Width="66"/>
                      <TextBlock Text="yrs" Classes="ml-muted" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="✓ Complete signing" Command="{Binding CompleteDealCommand}"
                            Classes="ml-primary" FontSize="13"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                  </StackPanel>
                </StackPanel>
              </Border>

              <ItemsControl ItemsSource="{Binding ProfileAbilities}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AbilityEntry">
                    <Grid ColumnDefinitions="*,34" Margin="2,1">
                      <TextBlock Text="{Binding Name}" Classes="ml-muted" FontSize="10"
                                 TextTrimming="CharacterEllipsis"/>
                      <Panel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Display}"
                                   Foreground="{Binding ValueBrush}" FontSize="10" FontWeight="Bold"/>
                        <Border Width="22" Height="8" CornerRadius="2"
                                Background="{Binding BandBrush}" IsVisible="{Binding ShowBand}"
                                HorizontalAlignment="Left"/>
                      </Panel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </Panel>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
