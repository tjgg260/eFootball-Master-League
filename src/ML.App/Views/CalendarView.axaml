<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ML.App.ViewModels"
             xmlns:app="using:ML.App"
             x:Class="ML.App.Views.CalendarView"
             x:DataType="vm:CalendarViewModel">
  <DockPanel Margin="20">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10">
      <Button Content="◀" Command="{Binding PrevMonthCommand}" Classes="ml-secondary"/>
      <TextBlock Grid.Column="1" Text="{Binding MonthTitle}" Classes="ml-h1"
                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
      <Button Grid.Column="2" Content="▶" Command="{Binding NextMonthCommand}" Classes="ml-secondary"/>
    </Grid>
    <UniformGrid DockPanel.Dock="Top" Columns="7" Margin="0,0,0,4">
      <TextBlock Text="Mon" Classes="ml-muted" HorizontalAlignment="Center"/>
      <TextBlock Text="Tue" Classes="ml-muted" HorizontalAlignment="Center"/>
      <TextBlock Text="Wed" Classes="ml-muted" HorizontalAlignment="Center"/>
      <TextBlock Text="Thu" Classes="ml-muted" HorizontalAlignment="Center"/>
      <TextBlock Text="Fri" Classes="ml-muted" HorizontalAlignment="Center"/>
      <TextBlock Text="Sat" Classes="ml-muted" HorizontalAlignment="Center"/>
      <TextBlock Text="Sun" Classes="ml-muted" HorizontalAlignment="Center"/>
    </UniformGrid>
    <ItemsControl ItemsSource="{Binding Cells}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:DayCell">
          <Border Background="{Binding Bg}" CornerRadius="6" Margin="2" Padding="6" MinHeight="76">
            <StackPanel Spacing="2">
              <DockPanel>
                <Image DockPanel.Dock="Right" Source="{Binding Crest}" Width="16" Height="16"/>
                <TextBlock Text="{Binding DayText}" Classes="ml-label"/>
              </DockPanel>
              <TextBlock Text="{Binding Line1}" Classes="ml-muted" Foreground="{Binding Fg}"
                         TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2"/>
              <TextBlock Text="{Binding Line2}" Foreground="#9FE6B4" FontSize="11" FontWeight="SemiBold"/>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </DockPanel>
</UserControl>
