<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ML.App.ViewModels"
             xmlns:app="using:ML.App"
             x:Class="ML.App.Views.BoardView"
             x:DataType="vm:BoardViewModel">

  <UserControl.Styles>
    <!-- An objective that a screen can answer reads as a link, not a button: same body type,
         link colour, no chrome. Objectives with no obvious home stay plain text. -->
    <Style Selector="Button.objLink">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.objLink /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.objLink:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
  </UserControl.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="28" Spacing="16">
    <TextBlock Text="The Board" Classes="ml-h1"/>
    <TextBlock Text="{Binding Summary}" Classes="ml-body"/>
    <!-- the man behind the demands: initials avatar (no photo art exists for board members) -->
    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,-6,0,0"
                IsVisible="{Binding HasChairman}">
      <Border Width="26" Height="26" CornerRadius="13" Background="{Binding ChairmanBrush}">
        <TextBlock Text="{Binding ChairmanMark}" Foreground="White" FontSize="10"
                   FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <TextBlock Classes="ml-muted" FontSize="12" Text="{Binding ChairmanLine}"
                 VerticalAlignment="Center"/>
    </StackPanel>
    <WrapPanel>
      <Border Classes="ml-card" Width="210" Margin="0,0,14,14"><StackPanel>
        <TextBlock Classes="ml-label" Text="EXPECTATION"/>
        <TextBlock Classes="ml-h1" Margin="0,4,0,0" Text="{Binding Expectation}" TextWrapping="Wrap"/></StackPanel></Border>
      <Border Classes="ml-card" Width="210" Margin="0,0,14,14"><StackPanel>
        <TextBlock Classes="ml-label" Text="CONFIDENCE"/>
        <TextBlock Classes="ml-h1" Margin="0,4,0,0" Text="{Binding ConfidenceLabel}"/>
        <ProgressBar Maximum="100" Value="{Binding Confidence}" Height="6" Margin="0,8,0,0"/></StackPanel></Border>
    </WrapPanel>
    <Border Classes="ml-panel"><StackPanel>
      <TextBlock Classes="ml-label" Margin="0,0,0,10" Text="Job security"/>
      <TextBlock Text="{Binding JobSecurity}" Classes="ml-body" TextWrapping="Wrap"/></StackPanel></Border>
    <Border Classes="ml-panel"><StackPanel>
      <TextBlock Classes="ml-label" Margin="0,0,0,10" Text="Season objectives"/>
      <TextBlock Classes="ml-muted" IsVisible="{Binding !Objectives.Count}"
                 Text="No objectives published yet — the board sets them once the season kicks off."/>
      <ItemsControl ItemsSource="{Binding Objectives}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ObjectiveLine">
            <Grid ColumnDefinitions="28,*,Auto,Auto" Margin="0,3">
              <TextBlock Text="{Binding Icon}" FontSize="13"/>
              <!-- league objectives open the table, cup objectives the cup; the rest stay text -->
              <Panel Grid.Column="1">
                <TextBlock Text="{Binding Description}" Classes="ml-body"
                           TextWrapping="Wrap" IsVisible="{Binding !HasNav}"/>
                <Button Classes="objLink" IsVisible="{Binding HasNav}"
                        Command="{Binding $parent[ItemsControl].((vm:BoardViewModel)DataContext).OpenObjectiveCommand}"
                        CommandParameter="{Binding}">
                  <TextBlock Text="{Binding LinkText}" Classes="ml-body"
                             Foreground="{StaticResource MlLink}" TextWrapping="Wrap"/>
                </Button>
              </Panel>
              <TextBlock Grid.Column="2" Text="{Binding Progress}" Foreground="#9FE6B4"
                         FontSize="12" Margin="10,0" VerticalAlignment="Center"/>
              <Border Grid.Column="3" Classes="ml-chip">
                <TextBlock Text="{Binding Importance}"/>
              </Border>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="{Binding FanLine}" Classes="ml-body" Foreground="{StaticResource MlWarn}" Margin="0,8,0,0"/>
      <Panel Width="520" Height="48" HorizontalAlignment="Left" IsVisible="{Binding FanTrendVisible}">
        <Rectangle Height="1" Fill="{StaticResource MlBorder}" VerticalAlignment="Center"/>
        <Polyline Points="{Binding FanPoints}" Stroke="{StaticResource MlWarn}" StrokeThickness="2" StrokeJoin="Round"/>
      </Panel>
    </StackPanel></Border>
    <Border Classes="ml-panel"><StackPanel Spacing="8">
      <TextBlock Classes="ml-label" Margin="0,0,0,2" Text="Club infrastructure"/>
      <TextBlock Text="{Binding FacilitiesLine}" Classes="ml-body"/>
      <WrapPanel>
        <Button Content="💷 Request budget" Command="{Binding RequestBudgetCommand}" Margin="0,2,6,0"
                Classes="ml-secondary" FontSize="12" ToolTip.Tip="{Binding RequestBudgetTip}"/>
        <Button Content="{Binding UpgradeTrainingLabel}" Command="{Binding UpgradeTrainingCommand}"
                Margin="0,2,6,0" Classes="ml-secondary" FontSize="12"/>
        <Button Content="{Binding UpgradeAcademyLabel}" Command="{Binding UpgradeAcademyCommand}"
                Margin="0,2,6,0" Classes="ml-secondary" FontSize="12"/>
      </WrapPanel>
      <TextBlock Text="{Binding LeverStatus}" Foreground="#9FE6B4" FontSize="12" TextWrapping="Wrap"/>
    </StackPanel></Border>
    <Border Classes="ml-panel" IsVisible="{Binding EloTrendVisible}"><StackPanel Spacing="6">
      <TextBlock Classes="ml-label" Margin="0,0,0,4" Text="Club trajectory"/>
      <TextBlock Text="{Binding EloTrendLabel}" Classes="ml-muted" FontSize="12"/>
      <Panel Width="520" Height="72" HorizontalAlignment="Left">
        <Rectangle Height="1" Fill="{StaticResource MlBorder}" VerticalAlignment="Center"/>
        <Polyline Points="{Binding EloPoints}" Stroke="{DynamicResource ThemeAccentBrush}"
                  StrokeThickness="2" StrokeJoin="Round"/>
      </Panel>
    </StackPanel></Border>
    <Border Classes="ml-panel" IsVisible="{Binding Sacked}" Background="#2E3A1F24"><StackPanel>
      <TextBlock Classes="ml-label" Margin="0,0,0,10" Text="You have been dismissed" Foreground="#F08A8A"/>
      <TextBlock Text="{Binding Summary}" Foreground="#E0B3B3" FontSize="14" TextWrapping="Wrap"/>
      <TextBlock Text="Accept an offer below to manage again — or start a new career from a fresh seed."
                 Classes="ml-body" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Border>
    <WrapPanel>
      <Border Classes="ml-card" Width="210" Margin="0,0,14,14"><StackPanel>
        <TextBlock Classes="ml-label" Text="REPUTATION"/>
        <TextBlock Classes="ml-h1" Margin="0,4,0,0" Text="{Binding ReputationLabel}"/>
        <ProgressBar Maximum="100" Value="{Binding Reputation}" Height="6" Margin="0,8,0,0"/></StackPanel></Border>
      <Border Classes="ml-card" Width="210" Margin="0,0,14,14"><StackPanel>
        <TextBlock Classes="ml-label" Text="CAREER"/>
        <TextBlock Text="{Binding CareerLine}" Classes="ml-body" Foreground="{StaticResource MlTextHeading}"
                   TextWrapping="Wrap" MaxWidth="360" Margin="0,4,0,0"/></StackPanel></Border>
    </WrapPanel>
    <Border Classes="ml-panel"><StackPanel>
      <TextBlock Classes="ml-label" Margin="0,0,0,10" Text="Job offers"/>
      <TextBlock Text="{Binding OffersNote}" Classes="ml-muted" FontSize="12"
                 TextWrapping="Wrap" Margin="0,0,0,8"/>
      <!-- right-click a row for the shared club menu (squad, scout, head-to-head) -->
      <ItemsControl x:Name="OffersList" ItemsSource="{Binding Offers}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:JobOfferRow">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,3">
              <!-- fixed-size slot keeps rows aligned even when a club has no crest art -->
              <Image Source="{Binding Crest}" Width="22" Height="22" Margin="0,0,8,0"
                     VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="{Binding Line}" Classes="ml-body"
                         VerticalAlignment="Center"/>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                <!-- two-step: the label itself becomes the confirmation -->
                <Button Content="{Binding AcceptLabel}" Classes="ml-primary ml-go"
                        Command="{Binding $parent[ItemsControl].((vm:BoardViewModel)DataContext).AcceptOfferCommand}"
                        CommandParameter="{Binding}"/>
                <Button Content="Decline" Classes="ml-secondary"
                        Foreground="{StaticResource MlDanger}"
                        Command="{Binding $parent[ItemsControl].((vm:BoardViewModel)DataContext).DeclineOfferCommand}"
                        CommandParameter="{Binding}"/>
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="{Binding OfferStatus}" Foreground="{StaticResource MlSuccessText}"
                 FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
    </StackPanel></Border>
  </StackPanel>
  </ScrollViewer>
</UserControl>
