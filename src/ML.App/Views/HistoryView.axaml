<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ML.App.ViewModels"
             xmlns:app="using:ML.App"
             x:Class="ML.App.Views.HistoryView"
             x:DataType="vm:HistoryViewModel">
  <ScrollViewer Padding="20" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="14">
      <Grid ColumnDefinitions="Auto,Auto,*">
        <TextBlock Text="History" Classes="ml-h1" VerticalAlignment="Center"/>
        <ComboBox Grid.Column="1" Margin="18,0,0,0" MinWidth="140"
                  ItemsSource="{Binding SeasonChoices}"
                  SelectedItem="{Binding SelectedSeason}"/>
        <TextBlock Grid.Column="2" Text="{Binding ArchiveNote}" Classes="ml-muted"
                   Margin="14,0,0,0" VerticalAlignment="Center"/>
      </Grid>
      <Grid ColumnDefinitions="3*,2*" >
        <StackPanel Grid.Column="0" Spacing="12" Margin="0,0,12,0">
          <Border Classes="ml-panel"><StackPanel>
            <TextBlock Classes="ml-label" Text="{Binding TopTableName}" Margin="0,0,0,10"/>
            <TextBlock Text="No archived table for this season yet." Classes="ml-muted"
                       IsVisible="{Binding !TopTable.Count}"/>
            <Grid ColumnDefinitions="34,20,*,40,34,34,34,44,44" Margin="0,0,0,4"
                  IsVisible="{Binding !!TopTable.Count}">
              <TextBlock Grid.Column="0" Text="Pos" Classes="ml-label"/>
              <TextBlock Grid.Column="2" Text="Team" Classes="ml-label" Margin="4,0,0,0"/>
              <TextBlock Grid.Column="3" Text="P" Classes="ml-label"/>
              <TextBlock Grid.Column="4" Text="W" Classes="ml-label"/>
              <TextBlock Grid.Column="5" Text="D" Classes="ml-label"/>
              <TextBlock Grid.Column="6" Text="L" Classes="ml-label"/>
              <TextBlock Grid.Column="7" Text="GD" Classes="ml-label"/>
              <TextBlock Grid.Column="8" Text="Pts" Classes="ml-label"/>
            </Grid>
            <ItemsControl ItemsSource="{Binding TopTable}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ArchiveTableRow">
                  <Grid ColumnDefinitions="34,20,*,40,34,34,34,44,44" Margin="0,1">
                    <TextBlock Text="{Binding Pos}" Foreground="{DynamicResource MlTextMuted}" FontSize="12"/>
                    <Image Grid.Column="1" Source="{Binding Crest}" Width="14" Height="14"
                           VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding Team}" FontSize="12" Margin="4,0,0,0"
                               Foreground="{Binding TeamBrush}" FontWeight="{Binding TeamWeight}"/>
                    <TextBlock Grid.Column="3" Text="{Binding P}" Foreground="{DynamicResource MlTextMuted}" FontSize="12"/>
                    <TextBlock Grid.Column="4" Text="{Binding W}" Foreground="{DynamicResource MlTextMuted}" FontSize="12"/>
                    <TextBlock Grid.Column="5" Text="{Binding D}" Foreground="{DynamicResource MlTextMuted}" FontSize="12"/>
                    <TextBlock Grid.Column="6" Text="{Binding L}" Foreground="{DynamicResource MlTextMuted}" FontSize="12"/>
                    <TextBlock Grid.Column="7" Text="{Binding GD}" Foreground="{DynamicResource MlTextMuted}" FontSize="12"/>
                    <TextBlock Grid.Column="8" Text="{Binding Pts}" Foreground="{DynamicResource MlTextHeading}"
                               FontWeight="Bold" FontSize="12"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel></Border>
          <Border Classes="ml-panel" IsVisible="{Binding HasSecondTable}"><StackPanel>
            <TextBlock Classes="ml-label" Text="{Binding SecondTableName}" Margin="0,0,0,10"/>
            <Grid ColumnDefinitions="34,20,*,40,34,34,34,44,44" Margin="0,0,0,4">
              <TextBlock Grid.Column="0" Text="Pos" Classes="ml-label"/>
              <TextBlock Grid.Column="2" Text="Team" Classes="ml-label" Margin="4,0,0,0"/>
              <TextBlock Grid.Column="3" Text="P" Classes="ml-label"/>
              <TextBlock Grid.Column="4" Text="W" Classes="ml-label"/>
              <TextBlock Grid.Column="5" Text="D" Classes="ml-label"/>
              <TextBlock Grid.Column="6" Text="L" Classes="ml-label"/>
              <TextBlock Grid.Column="7" Text="GD" Classes="ml-label"/>
              <TextBlock Grid.Column="8" Text="Pts" Classes="ml-label"/>
            </Grid>
            <ItemsControl ItemsSource="{Binding SecondTable}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ArchiveTableRow">
                  <Grid ColumnDefinitions="34,20,*,40,34,34,34,44,44" Margin="0,1">
                    <TextBlock Text="{Binding Pos}" Foreground="{DynamicResource MlTextMuted}" FontSize="12"/>
                    <Image Grid.Column="1" Source="{Binding Crest}" Width="14" Height="14"
                           VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding Team}" FontSize="12" Margin="4,0,0,0"
                               Foreground="{Binding TeamBrush}" FontWeight="{Binding TeamWeight}"/>
                    <TextBlock Grid.Column="3" Text="{Binding P}" Foreground="{DynamicResource MlTextMuted}" FontSize="12"/>
                    <TextBlock Grid.Column="4" Text="{Binding W}" Foreground="{DynamicResource MlTextMuted}" FontSize="12"/>
                    <TextBlock Grid.Column="5" Text="{Binding D}" Foreground="{DynamicResource MlTextMuted}" FontSize="12"/>
                    <TextBlock Grid.Column="6" Text="{Binding L}" Foreground="{DynamicResource MlTextMuted}" FontSize="12"/>
                    <TextBlock Grid.Column="7" Text="{Binding GD}" Foreground="{DynamicResource MlTextMuted}" FontSize="12"/>
                    <TextBlock Grid.Column="8" Text="{Binding Pts}" Foreground="{DynamicResource MlTextHeading}"
                               FontWeight="Bold" FontSize="12"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel></Border>
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="12">
          <Border Classes="ml-panel"><StackPanel>
            <TextBlock Classes="ml-label" Text="Honours" Margin="0,0,0,10"/>
            <TextBlock Text="Honours are engraved here when the season ends." Classes="ml-muted"
                       IsVisible="{Binding !SeasonHonours.Count}"/>
            <ItemsControl ItemsSource="{Binding SeasonHonours}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ArchiveHonourRow">
                  <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,2">
                    <TextBlock Text="{Binding Competition}" Classes="ml-body"
                               Foreground="{DynamicResource MlTextMuted}"/>
                    <Image Grid.Column="1" Source="{Binding Crest}" Width="16" Height="16"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Grid.Column="2" Text="{Binding Team}" Classes="ml-body"
                               Foreground="{DynamicResource MlTextHeading}" FontWeight="Bold"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel></Border>
          <Border Classes="ml-panel"><StackPanel>
            <TextBlock Classes="ml-label" Text="Top scorers" Margin="0,0,0,10"/>
            <TextBlock Text="No goals on record for this season yet." Classes="ml-muted"
                       IsVisible="{Binding !SeasonScorers.Count}"/>
            <ItemsControl ItemsSource="{Binding SeasonScorers}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ArchiveScorerRow">
                  <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding Player}" Classes="ml-body"/>
                      <TextBlock Text="{Binding Team}" Classes="ml-muted"
                                 VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding Goals}" Classes="ml-body"
                               Foreground="{DynamicResource MlTextHeading}" FontWeight="Bold"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel></Border>
          <Border Classes="ml-panel"><StackPanel>
            <TextBlock Classes="ml-label" Text="Club records" Margin="0,0,0,10"/>
            <TextBlock Text="{Binding RecordsNote}" Classes="ml-muted"
                       IsVisible="{Binding !Records.Count}"/>
            <ItemsControl ItemsSource="{Binding Records}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="app:ClubRecordRow">
                  <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                    <TextBlock Text="{Binding Record}" Classes="ml-body"
                               Foreground="{DynamicResource MlTextMuted}" Width="150"/>
                    <TextBlock Grid.Column="1" Text="{Binding Holder}" Classes="ml-body"
                               Foreground="{DynamicResource MlTextHeading}" TextWrapping="Wrap"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel></Border>
        </StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
