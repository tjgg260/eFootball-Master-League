<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ML.App.ViewModels"
        xmlns:app="using:ML.App"
        x:Class="ML.App.Views.NewCareerWindow"
        x:DataType="vm:NewCareerViewModel"
        Title="New Career" Width="1000" Height="680"
        Background="#0E1116" WindowStartupLocation="CenterScreen">

  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="0">
    <StackPanel Grid.Row="0" Margin="28,24,28,6">
      <TextBlock Text="Start a Career" FontSize="28" FontWeight="Bold" Foreground="White"/>
      <TextBlock Text="Pick a country, then a league — Premier League to National League — then your club. Real squads, real divisions."
                 Foreground="#8A93A2" FontSize="14" Margin="0,4,0,0"/>
    </StackPanel>

    <!-- country + league dropdowns -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="28,8,28,10">
      <TextBlock Text="COUNTRY" Foreground="#7C8698" FontSize="11" FontWeight="Bold"
                 VerticalAlignment="Center"/>
      <ComboBox ItemsSource="{Binding Countries}" SelectedItem="{Binding SelectedCountry}"
                MinWidth="230" MaxDropDownHeight="420">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="app:CatalogCountry">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding Name}" Foreground="White" FontSize="14" FontWeight="SemiBold"
                         VerticalAlignment="Center"/>
              <TextBlock Text="{Binding Summary}" Foreground="#8A93A2" FontSize="11"
                         VerticalAlignment="Center"/>
            </StackPanel>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <TextBlock Text="LEAGUE" Foreground="#7C8698" FontSize="11" FontWeight="Bold"
                 VerticalAlignment="Center" Margin="10,0,0,0"/>
      <ComboBox ItemsSource="{Binding Leagues}" SelectedItem="{Binding SelectedLeague}"
                MinWidth="280" MaxDropDownHeight="420">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="app:CatalogLeague">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding Name}" Foreground="White" FontSize="14" FontWeight="SemiBold"
                         VerticalAlignment="Center"/>
              <TextBlock Text="{Binding Summary}" Foreground="#8A93A2" FontSize="11"
                         VerticalAlignment="Center"/>
            </StackPanel>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </StackPanel>

    <!-- teams -->
    <Grid Grid.Row="2" Margin="28,0,28,6">
      <Border Background="#151A21" CornerRadius="10">
        <ListBox ItemsSource="{Binding Teams}" SelectedItem="{Binding SelectedTeam}"
                 Background="Transparent" BorderThickness="0">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:CareerTeamOption">
              <Border Width="150" Height="120" Margin="6" CornerRadius="10" Background="#1B222C">
                <StackPanel Margin="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Panel Width="56" Height="56" HorizontalAlignment="Center">
                    <Border CornerRadius="28" Background="{Binding BadgeBrush}">
                      <TextBlock Text="{Binding Badge}" Foreground="White" FontWeight="Bold"
                                 FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Image Source="{Binding Logo}" Width="56" Height="56"/>
                  </Panel>
                  <TextBlock Text="{Binding Name}" Foreground="White" FontSize="12" TextAlignment="Center"
                             TextWrapping="Wrap" MaxLines="2" Margin="0,6,0,0"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>
    </Grid>

    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="28,10,28,22">
      <TextBlock Grid.Column="0" Text="{Binding Status}" Foreground="#9FE6B4" FontSize="13"
                 VerticalAlignment="Center" TextWrapping="Wrap"/>
      <Button Grid.Column="1" Content="Start Career  ▶" Command="{Binding StartCareerCommand}"
              IsEnabled="{Binding !Busy}" FontSize="16" FontWeight="Bold" Padding="26,14"
              Background="#1F9D4D" Foreground="White" CornerRadius="8"/>
    </Grid>
  </Grid>
</Window>
