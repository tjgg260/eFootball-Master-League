<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ML.App.ViewModels"
             xmlns:app="using:ML.App"
             x:Class="ML.App.Views.StaffView"
             x:DataType="vm:StaffViewModel">

  <UserControl.Styles>
    <!-- Desk cards are clickable (aim the market picker at that desk) without looking
         like buttons: neutralise the Fluent button chrome, local to this screen. -->
    <Style Selector="Button.deskCard">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="CornerRadius" Value="{StaticResource MlRadiusCard}"/>
    </Style>
    <Style Selector="Button.deskCard:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.deskCard:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <!-- an inline hint that is also the way out of the problem it names: same weight and
         colour as the warning text it replaces, but clickable. -->
    <Style Selector="Button.hintLink">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Foreground" Value="{StaticResource MlWarn}"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.hintLink /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.hintLink:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.hintLink:pointerover">
      <Setter Property="Foreground" Value="{StaticResource MlLink}"/>
    </Style>
  </UserControl.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
  <Grid Margin="20" ColumnDefinitions="*,420" RowDefinitions="Auto,Auto,*">
    <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,10">
      <TextBlock Classes="ml-h1" Text="Backroom Staff"/>
      <TextBlock Classes="ml-muted" Text="{Binding WageLine}" FontSize="12" Margin="0,4,0,0"/>
      <TextBlock Classes="ml-body" Text="{Binding Status}" Foreground="#9FE6B4" FontSize="12"
                 TextWrapping="Wrap" Margin="0,4,0,0"/>
    </StackPanel>

    <!-- your backroom: one card per desk, attributes + tactical preference -->
    <ScrollViewer Grid.Row="1" Grid.RowSpan="2" Grid.Column="0" Margin="0,0,10,0">
      <ItemsControl ItemsSource="{Binding Backroom}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:BackroomCard">
            <!-- whole card clicks through to the market picker for this desk's role -->
            <Button Classes="deskCard" Margin="0,0,0,7"
                    Command="{Binding $parent[ItemsControl].((vm:StaffViewModel)DataContext).SelectDeskCommand}"
                    CommandParameter="{Binding}">
              <Border Classes="ml-card" Padding="12,9">
                <Grid ColumnDefinitions="150,44,*,Auto">
                  <StackPanel>
                    <TextBlock Classes="ml-label" Text="{Binding Role}"/>
                    <TextBlock Text="{Binding Stars}" Foreground="{StaticResource MlGold}" FontSize="12"/>
                  </StackPanel>
                  <!-- staff have no photos anywhere: the initials avatar is the identity.
                       A vacant desk shows an empty ring — a seat waiting to be filled. -->
                  <Panel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Border Width="34" Height="34" CornerRadius="17"
                            Background="{Binding AvatarBrush}" IsVisible="{Binding Filled}">
                      <TextBlock Text="{Binding Mark}" Foreground="White" FontSize="12"
                                 FontWeight="Bold" HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>
                    </Border>
                    <Border Width="34" Height="34" CornerRadius="17" BorderThickness="1"
                            BorderBrush="{StaticResource MlBorder}" IsVisible="{Binding !Filled}"/>
                  </Panel>
                  <StackPanel Grid.Column="2" Spacing="1">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Classes="ml-h2" FontSize="14" Text="{Binding Name}"/>
                      <TextBlock Classes="ml-muted" FontSize="12" Text="{Binding AgeLine}" VerticalAlignment="Center"/>
                      <TextBlock Classes="ml-muted" FontSize="12" Text="{Binding Wage}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Classes="ml-body" FontSize="12" Text="{Binding AttrLine}"/>
                    <TextBlock Classes="ml-muted" Text="{Binding StyleLine}"
                               Foreground="{StaticResource MlLink}" FontStyle="Italic"/>
                    <!-- the contract has always been on the record; it just never reached the card -->
                    <TextBlock Classes="ml-muted" Text="{Binding ContractLine}"
                               IsVisible="{Binding Filled}"/>
                    <TextBlock Classes="ml-muted" Text="Desk vacant — click to browse candidates in the market"
                               IsVisible="{Binding !Filled}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6"
                              VerticalAlignment="Center" IsVisible="{Binding Filled}">
                    <Button Classes="ml-secondary" Content="📃 Renew" FontSize="11"
                            Command="{Binding $parent[ItemsControl].((vm:StaffViewModel)DataContext).RenewCommand}"
                            CommandParameter="{Binding}"/>
                    <!-- two-step: the label itself becomes the confirmation -->
                    <Button Classes="ml-secondary" Content="{Binding ReleaseLabel}"
                            Foreground="{StaticResource MlDanger}" FontSize="11"
                            Command="{Binding $parent[ItemsControl].((vm:StaffViewModel)DataContext).ReleaseCommand}"
                            CommandParameter="{Binding}"/>
                  </StackPanel>
                </Grid>
              </Border>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- the market: free agents per role, best first -->
    <Border Grid.Row="1" Grid.Column="1" Classes="ml-panel">
      <StackPanel Spacing="8">
        <TextBlock Classes="ml-label" Text="STAFF MARKET"/>
        <ComboBox ItemsSource="{Binding RoleOptions}" SelectedItem="{Binding SelectedRole}"
                  HorizontalAlignment="Stretch"/>
        <!-- right-click a candidate for the full 1-20 profile and the hire (code-behind) -->
        <ListBox x:Name="MarketList"
                 ItemsSource="{Binding Market}" SelectedItem="{Binding SelectedCandidate}"
                 Background="Transparent" BorderThickness="0" MaxHeight="330">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:StaffMarketRow">
              <Grid ColumnDefinitions="Auto,*" Margin="2,4">
                <Border Width="28" Height="28" CornerRadius="14" Margin="0,2,8,0"
                        VerticalAlignment="Top" Background="{Binding AvatarBrush}">
                  <TextBlock Text="{Binding Mark}" Foreground="White" FontSize="10"
                             FontWeight="Bold" HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="ml-h2" FontSize="13" Text="{Binding Name}"/>
                    <TextBlock Classes="ml-muted" FontSize="12" Text="{Binding Age}"/>
                    <TextBlock Text="{Binding Stars}" Foreground="{StaticResource MlGold}" FontSize="12"/>
                    <TextBlock Classes="ml-muted" FontSize="12" Text="{Binding Wage}"/>
                  </StackPanel>
                  <TextBlock Classes="ml-body" FontSize="11" Text="{Binding KeyAttrs}"/>
                  <TextBlock Classes="ml-muted" Text="{Binding Style}"
                             Foreground="{StaticResource MlLink}" FontStyle="Italic"/>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Classes="ml-muted" Text="No free agents available for this desk right now — check back next matchday."
                   TextWrapping="Wrap" IsVisible="{Binding !HasMarket}"/>
        <TextBlock Classes="ml-muted" Text="Right-click a candidate for his full attribute profile."
                   TextWrapping="Wrap" IsVisible="{Binding HasMarket}"/>
        <Button Classes="ml-primary ml-go" Content="Hire selected" Command="{Binding HireCommand}"/>
      </StackPanel>
    </Border>

    <!-- delegation: hand duties to the people you hired -->
    <Border Grid.Row="2" Grid.Column="1" Classes="ml-panel" Margin="0,10,0,0" VerticalAlignment="Top">
      <StackPanel Spacing="6">
        <TextBlock Classes="ml-label" Text="DELEGATION"/>
        <ItemsControl ItemsSource="{Binding Toggles}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:DelegationToggle">
              <StackPanel Margin="0,2">
                <!-- a delegation with nobody at the desk is disabled, not a silent no-op -->
                <CheckBox IsChecked="{Binding IsOn}" Content="{Binding Label}"
                          IsEnabled="{Binding RoleFilled}"
                          Foreground="{StaticResource MlTextBody}" FontSize="12"/>
                <!-- the missing desk is now the way to fill it: aims the market at that role -->
                <Button Classes="hintLink" Content="{Binding HintLink}"
                        Margin="26,0,0,0" IsVisible="{Binding !RoleFilled}"
                        Command="{Binding $parent[ItemsControl].((vm:StaffViewModel)DataContext).AimAtRoleCommand}"
                        CommandParameter="{Binding RoleNeeded}"/>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </Grid>
  </ScrollViewer>
</UserControl>
