<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ML.App.ViewModels"
        xmlns:app="using:ML.App"
        xmlns:views="using:ML.App.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="ML.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Master League" Width="1640" Height="820" MinWidth="1280" MinHeight="700"
        Background="{DynamicResource ThemeBgBrush}" TransparencyLevelHint="Mica">

  <Window.Styles>
    <!-- monochrome nav glyphs: muted at rest, heading-white on the active row -->
    <Style Selector="Button.nav TextBlock.navIcon">
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Foreground" Value="{StaticResource MlTextMuted}"/>
    </Style>
    <Style Selector="Button.nav.active TextBlock.navIcon">
      <Setter Property="Foreground" Value="{StaticResource MlTextHeading}"/>
    </Style>
  </Window.Styles>

  <Window.DataTemplates>
    <!-- page templates: VM -> view -->
    <DataTemplate DataType="vm:DashboardViewModel">
      <views:DashboardView/>
    </DataTemplate>

    <DataTemplate DataType="vm:TableViewModel">
      <views:TableView/>
    </DataTemplate>

    <DataTemplate DataType="vm:SquadViewModel">
      <views:SquadView/>
    </DataTemplate>

    <DataTemplate DataType="vm:MarketViewModel">
      <views:MarketView/>
    </DataTemplate>

    <DataTemplate DataType="vm:FinancesViewModel">
      <views:FinancesView/>
    </DataTemplate>

    <DataTemplate DataType="vm:BoardViewModel">
      <views:BoardView/>
    </DataTemplate>

    <DataTemplate DataType="vm:CalendarViewModel">
      <views:CalendarView/>
    </DataTemplate>

    <DataTemplate DataType="vm:TacticsViewModel">
      <views:TacticsView/>
    </DataTemplate>

    <DataTemplate DataType="vm:ScoutingViewModel">
      <views:ScoutingView/>
    </DataTemplate>

    <DataTemplate DataType="vm:StaffViewModel">
      <views:StaffView/>
    </DataTemplate>

    <DataTemplate DataType="vm:StatsViewModel">
      <views:StatsView/>
    </DataTemplate>

    <DataTemplate DataType="vm:CupViewModel">
      <views:CupView/>
    </DataTemplate>

    <DataTemplate DataType="vm:HistoryViewModel">
      <views:HistoryView/>
    </DataTemplate>

    <DataTemplate DataType="vm:SettingsViewModel">
      <views:SettingsView/>
    </DataTemplate>

    <DataTemplate DataType="vm:AcademyViewModel">
      <views:AcademyView/>
    </DataTemplate>


    <DataTemplate DataType="vm:TrainingViewModel">
      <views:TrainingView/>
    </DataTemplate>

    <DataTemplate DataType="vm:InboxViewModel">
      <views:InboxView/>
    </DataTemplate>

    <!-- Destinations, not nav rows: you arrive on these by clicking a player, so they have
         no sidebar entry — but they are pages like any other and need their template here
         or the shell would render a ViewModel's type name where the screen should be. -->
    <DataTemplate DataType="vm:PlayerViewModel">
      <views:PlayerView/>
    </DataTemplate>

    <DataTemplate DataType="vm:BiddingViewModel">
      <views:BiddingView/>
    </DataTemplate>

    <DataTemplate DataType="vm:MatchReportViewModel">
      <views:MatchReportView/>
    </DataTemplate>
  </Window.DataTemplates>

  <Grid ColumnDefinitions="230,*">
    <!-- sidebar -->
    <Border Grid.Column="0" Background="{DynamicResource ThemePanelAltBrush}">
      <DockPanel Margin="16,12">
        <StackPanel DockPanel.Dock="Top" Margin="6,4,6,10">
          <!-- Back / forward. Pages rebuild from the DB on every visit, so history holds
               (page, focus) entries rather than ViewModels — Back replays the trip instead of
               resurrecting a stale squad. Both routes pass the unsaved-work guard. -->
          <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,0,6">
            <Button Classes="ml-ghost" Padding="8,3" FontSize="14"
                    Content="&#x2190;" Command="{Binding GoBackCommand}"
                    ToolTip.Tip="{Binding BackTip}"/>
            <Button Classes="ml-ghost" Padding="8,3" FontSize="14"
                    Content="&#x2192;" Command="{Binding GoForwardCommand}"
                    ToolTip.Tip="{Binding ForwardTip}"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Image Source="{Binding Crest}" Width="40" Height="40" IsVisible="{Binding HasCrest}"
                   VerticalAlignment="Center"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Classes="ml-h2" Text="{Binding ClubName}"
                         TextWrapping="Wrap" MaxWidth="140"/>
              <TextBlock Classes="ml-muted" Text="{Binding LeagueName}"/>
            </StackPanel>
          </StackPanel>
          <TextBlock Classes="ml-label" Text="{Binding DateLine}"
                     Foreground="{StaticResource MlSuccessText}" Margin="0,10,0,0"/>
          <!-- pending decisions: each line is a button to the screen that resolves it -->
          <ItemsControl ItemsSource="{Binding Alerts}" Margin="0,4,0,0"
                        IsVisible="{Binding HasActions}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ActionAlert">
                <Button Classes="ml-ghost" Padding="4,2" HorizontalAlignment="Left"
                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenAlertCommand}"
                        CommandParameter="{Binding}">
                  <TextBlock Classes="ml-label" Foreground="{StaticResource MlDanger}"
                             Text="{Binding Text}" TextWrapping="Wrap"/>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Classes="ml-primary ml-go" Content="Continue →"
                  Command="{Binding ContinueToOfficeCommand}"
                  FontSize="12" FontWeight="Bold"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  Margin="0,8,0,0"/>
        </StackPanel>

        <!-- Settings pinned at the foot, outside the scroll -->
        <Button DockPanel.Dock="Bottom" Classes="nav" Margin="0,8,0,0"
                Classes.active="{Binding SettingsItem.IsActive}"
                HorizontalContentAlignment="Stretch"
                Command="{Binding NavigateCommand}"
                CommandParameter="{Binding SettingsItem}">
          <Grid ColumnDefinitions="18,*">
            <TextBlock Grid.Column="0" Classes="navIcon" Text="{Binding SettingsItem.Icon}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="{Binding SettingsItem.Title}"
                       Margin="12,0,0,0" VerticalAlignment="Center"/>
          </Grid>
        </Button>

        <!-- AllowAutoHide off: when the list does overflow (a short window, several alerts above
             it) the bar stays drawn, so rows below the fold are never a secret. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      AllowAutoHide="False">
          <ItemsControl ItemsSource="{Binding Sections}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:NavSection">
                <StackPanel Margin="0,0,0,6">
                  <TextBlock Classes="ml-label" Text="{Binding Header}"
                             LetterSpacing="1" Margin="14,0,0,2"/>
                  <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:NavItem">
                        <Button Classes="nav" Classes.active="{Binding IsActive}"
                                HorizontalContentAlignment="Stretch"
                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).NavigateCommand}"
                                CommandParameter="{Binding}">
                          <Grid ColumnDefinitions="18,*,Auto">
                            <TextBlock Grid.Column="0" Classes="navIcon" Text="{Binding Icon}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Title}"
                                       Margin="12,0,0,0" VerticalAlignment="Center"/>
                            <!-- unread pill (News) -->
                            <Border Grid.Column="2" Background="{StaticResource MlPrimary}"
                                    CornerRadius="9" Padding="6,1" MinWidth="18"
                                    IsVisible="{Binding HasBadge}" VerticalAlignment="Center">
                              <TextBlock Text="{Binding BadgeCount}" FontSize="10" FontWeight="Bold"
                                         Foreground="White" HorizontalAlignment="Center"/>
                            </Border>
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- content -->
    <Panel Grid.Column="1">
      <ContentControl Content="{Binding CurrentPage}"/>

      <!-- Unsaved-work guard: pages are rebuilt from the DB on every nav click, so leaving
           used to destroy in-memory edits without a word. Nothing navigates until this is
           answered. -->
      <Border IsVisible="{Binding LeaveArmed}" VerticalAlignment="Top" HorizontalAlignment="Center"
              Background="{StaticResource MlSurfaceCard}" BorderBrush="{StaticResource MlWarn}"
              BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,14,0,0"
              BoxShadow="0 10 30 #90000000">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <TextBlock Text="{Binding LeavePrompt}" VerticalAlignment="Center"
                     Foreground="{StaticResource MlTextHeading}" FontSize="13" TextWrapping="Wrap"
                     MaxWidth="420"/>
          <Button Classes="ml-primary ml-go" Content="Save &amp; go" FontSize="12"
                  Command="{Binding SaveAndLeaveCommand}"/>
          <Button Classes="ml-secondary" Content="Discard &amp; go" FontSize="12"
                  Command="{Binding DiscardAndLeaveCommand}"/>
          <Button Classes="ml-ghost" Content="Stay" FontSize="12"
                  Command="{Binding DismissLeaveCommand}"/>
        </StackPanel>
      </Border>
    </Panel>
  </Grid>
</Window>
