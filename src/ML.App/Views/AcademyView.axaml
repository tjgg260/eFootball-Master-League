<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ML.App.ViewModels"
             xmlns:app="using:ML.App"
             x:Class="ML.App.Views.AcademyView"
             x:DataType="vm:AcademyViewModel">
  <DockPanel Margin="20">
    <TextBlock DockPanel.Dock="Top" Classes="ml-h1" Text="Academy" Margin="0,0,0,8"/>

    <!-- The youth setup, finally on screen: intake, then the two sides beneath the first team.
         Active tab wears ml-primary, the rest ml-ghost — the classes are mutually exclusive so
         only one Theme.axaml rule ever applies to a button. -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
      <Button Content="🎓 Academy" FontSize="12" Padding="14,7"
              Command="{Binding SelectTabCommand}" CommandParameter="academy"
              Classes.ml-primary="{Binding IsAcademyTab}" Classes.ml-ghost="{Binding !IsAcademyTab}"/>
      <Button Content="U21" FontSize="12" Padding="14,7"
              Command="{Binding SelectTabCommand}" CommandParameter="u21"
              Classes.ml-primary="{Binding IsU21Tab}" Classes.ml-ghost="{Binding !IsU21Tab}"/>
      <Button Content="U18" FontSize="12" Padding="14,7"
              Command="{Binding SelectTabCommand}" CommandParameter="u18"
              Classes.ml-primary="{Binding IsU18Tab}" Classes.ml-ghost="{Binding !IsU18Tab}"/>
    </StackPanel>

    <TextBlock DockPanel.Dock="Top" Classes="ml-muted" Text="{Binding Note}" Margin="0,0,0,10"
               TextWrapping="Wrap" IsVisible="{Binding HasNote}"/>

    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <!-- P6: command CanExecute disables these until a lad is selected -->
      <Button DockPanel.Dock="Left" Content="Promote to senior squad" Command="{Binding PromoteCommand}"
              Classes="ml-primary ml-go" Padding="18,10" Margin="0,0,14,0"
              IsVisible="{Binding IsAcademyTab}"/>
      <Button DockPanel.Dock="Left" Content="⬆ Promote to first team" Command="{Binding PromoteYouthCommand}"
              Classes="ml-primary ml-go" Padding="18,10" Margin="0,0,14,0"
              IsVisible="{Binding IsYouthTab}"/>
      <TextBlock Text="{Binding Status}" Foreground="{StaticResource MlSuccessText}" FontSize="13"
                 VerticalAlignment="Center" TextWrapping="Wrap"/>
    </DockPanel>

    <Panel>
      <DataGrid x:Name="AcademyGrid" ItemsSource="{Binding Rows}"
                SelectedItem="{Binding Selected, Mode=TwoWay}" IsVisible="{Binding IsAcademyTab}"
                IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="" Width="46">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:AcademyEntry">
                <Border Width="32" Height="32" CornerRadius="16" Background="{Binding FaceBrush}"
                        Margin="4,2" ClipToBounds="True">
                  <Panel>
                    <TextBlock Text="{Binding Mark}" Foreground="#20262E" FontSize="10"
                               FontWeight="Bold" HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    <Image Source="{Binding Portrait}" Stretch="UniformToFill"
                           IsVisible="{Binding HasPortrait}"/>
                  </Panel>
                </Border>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
          <DataGridTextColumn Header="Pos" Binding="{Binding Position}" Width="70"/>
          <DataGridTextColumn Header="Age" Binding="{Binding Age}" Width="62"/>
          <DataGridTemplateColumn Header="Rating" Width="78">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:AcademyEntry">
                <TextBlock Text="{Binding Grade}" Foreground="{Binding RatingBrush}"
                           FontWeight="Bold" VerticalAlignment="Center" Margin="8,0"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Potential" Width="110">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:AcademyEntry">
                <TextBlock Text="{Binding Potential}" Foreground="{StaticResource MlWarn}"
                           VerticalAlignment="Center" Margin="8,0"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>

      <DataGrid x:Name="YouthGrid" ItemsSource="{Binding YouthRows}"
                SelectedItem="{Binding SelectedYouth, Mode=TwoWay}" IsVisible="{Binding IsYouthTab}"
                IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
          <DataGridTextColumn Header="Pos" Binding="{Binding Position}" Width="70"/>
          <DataGridTextColumn Header="Age" Binding="{Binding Age}" Width="62"/>
          <DataGridTemplateColumn Header="Rating" Width="78">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:YouthEntry">
                <TextBlock Text="{Binding Grade}" Foreground="{Binding RatingBrush}"
                           FontWeight="Bold" VerticalAlignment="Center" Margin="8,0"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Potential" Width="110">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:YouthEntry">
                <TextBlock Text="{Binding Potential}" Foreground="{StaticResource MlWarn}"
                           VerticalAlignment="Center" Margin="8,0"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="70"/>
        </DataGrid.Columns>
      </DataGrid>

      <!-- empty state (P6): the academy between classes is a promise, not a void -->
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6"
                  IsVisible="{Binding ShowAcademyEmpty}">
        <TextBlock Classes="ml-muted" Text="Intake day brings the next class."
                   HorizontalAlignment="Center"/>
        <Button Classes="ml-ghost" Content="📅 See when — open the Calendar" FontSize="12"
                HorizontalAlignment="Center" Foreground="{StaticResource MlLink}"
                Command="{Binding OpenCalendarCommand}"/>
      </StackPanel>
      <TextBlock Classes="ml-empty" IsVisible="{Binding ShowYouthEmpty}"
                 Text="Nobody at this level yet — send a young first-teamer down, or promote a prospect into him."/>
    </Panel>
  </DockPanel>
</UserControl>
