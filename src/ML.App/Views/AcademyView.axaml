<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ML.App.ViewModels"
             xmlns:app="using:ML.App"
             x:Class="ML.App.Views.AcademyView"
             x:DataType="vm:AcademyViewModel">
  <DockPanel Margin="20">
    <TextBlock DockPanel.Dock="Top" Classes="ml-h1" Text="Academy" Margin="0,0,0,8"/>

    <!-- The youth setup, finally on screen: intake, then the two sides beneath the first team.
         Active tab wears ml-primary, the rest ml-ghost — the classes are mutually exclusive so
         only one Theme.axaml rule ever applies to a button. -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
      <Button Content="🎓 Academy" FontSize="12" Padding="14,7"
              Command="{Binding SelectTabCommand}" CommandParameter="academy"
              Classes.ml-primary="{Binding IsAcademyTab}" Classes.ml-ghost="{Binding !IsAcademyTab}"/>
      <Button Content="U21" FontSize="12" Padding="14,7"
              Command="{Binding SelectTabCommand}" CommandParameter="u21"
              Classes.ml-primary="{Binding IsU21Tab}" Classes.ml-ghost="{Binding !IsU21Tab}"/>
      <Button Content="U18" FontSize="12" Padding="14,7"
              Command="{Binding SelectTabCommand}" CommandParameter="u18"
              Classes.ml-primary="{Binding IsU18Tab}" Classes.ml-ghost="{Binding !IsU18Tab}"/>
    </StackPanel>

    <!-- The note is now written on EVERY state, including the empty ones — HasNote used to
         hide it exactly when a manager had never seen the screen work. -->
    <TextBlock DockPanel.Dock="Top" Classes="ml-muted" Text="{Binding Note}" Margin="0,0,0,10"
               TextWrapping="Wrap" IsVisible="{Binding HasNote}"/>

    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <!-- P6: command CanExecute disables these until a lad is selected -->
      <Button DockPanel.Dock="Left" Content="Promote to senior squad" Command="{Binding PromoteCommand}"
              Classes="ml-primary ml-go" Padding="18,10" Margin="0,0,14,0"
              IsVisible="{Binding IsAcademyTab}"/>
      <Button DockPanel.Dock="Left" Content="⬆ Promote to first team" Command="{Binding PromoteYouthCommand}"
              Classes="ml-primary ml-go" Padding="18,10" Margin="0,0,14,0"
              IsVisible="{Binding IsYouthTab}"/>
      <!-- The other direction, and the affordance the empty state used to only describe.
           It is a signpost to the Squad screen, and the tooltip says so. -->
      <Button DockPanel.Dock="Left" Content="{Binding SendDownLabel}" Command="{Binding OpenSquadCommand}"
              Classes="ml-secondary" Padding="14,10" Margin="0,0,14,0"
              ToolTip.Tip="{Binding SendDownHint}"
              IsVisible="{Binding IsYouthTab}"/>
      <!-- The status line carries engine prose, so it carries the engine's TONE too: a refusal
           ("Too old for the U18s.") used to be painted in the assistant's success green. -->
      <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontSize="13"
                 VerticalAlignment="Center" TextWrapping="Wrap"/>
    </DockPanel>

    <Panel>
      <DataGrid x:Name="AcademyGrid" ItemsSource="{Binding Rows}"
                SelectedItem="{Binding Selected, Mode=TwoWay}" IsVisible="{Binding IsAcademyTab}"
                IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="" Width="46">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:AcademyEntry">
                <Border Width="32" Height="32" CornerRadius="16" Background="{Binding FaceBrush}"
                        Margin="4,2" ClipToBounds="True">
                  <Panel>
                    <TextBlock Text="{Binding Mark}" Foreground="#20262E" FontSize="10"
                               FontWeight="Bold" HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    <Image Source="{Binding Portrait}" Stretch="UniformToFill"
                           IsVisible="{Binding HasPortrait}"/>
                  </Panel>
                </Border>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
          <DataGridTextColumn Header="Pos" Binding="{Binding Position}" Width="71"/>
          <DataGridTextColumn Header="Age" Binding="{Binding Age}" Width="76"/>
          <DataGridTemplateColumn Header="Rating" Width="78">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:AcademyEntry">
                <TextBlock Text="{Binding Grade}" Foreground="{Binding RatingBrush}"
                           FontWeight="Bold" VerticalAlignment="Center" Margin="8,0"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Potential" Width="110">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:AcademyEntry">
                <TextBlock Text="{Binding Potential}" Foreground="{StaticResource MlWarn}"
                           VerticalAlignment="Center" Margin="8,0"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>

      <!-- Same row anatomy as the academy grid, column for column: the avatar used to appear
           and disappear as you changed tabs, so every name jumped 46px sideways. The last
           column was "Level", which only ever repeated the tab you were already on — it now
           carries the one read that varies per lad. -->
      <DataGrid x:Name="YouthGrid" ItemsSource="{Binding YouthRows}"
                SelectedItem="{Binding SelectedYouth, Mode=TwoWay}" IsVisible="{Binding IsYouthTab}"
                IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="" Width="46">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:YouthEntry">
                <Border Width="32" Height="32" CornerRadius="16" Background="{Binding FaceBrush}"
                        Margin="4,2" ClipToBounds="True">
                  <Panel>
                    <TextBlock Text="{Binding Mark}" Foreground="#20262E" FontSize="10"
                               FontWeight="Bold" HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    <Image Source="{Binding Portrait}" Stretch="UniformToFill"
                           IsVisible="{Binding HasPortrait}"/>
                  </Panel>
                </Border>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
          <DataGridTextColumn Header="Pos" Binding="{Binding Position}" Width="71"/>
          <DataGridTextColumn Header="Age" Binding="{Binding Age}" Width="76"/>
          <DataGridTemplateColumn Header="Rating" Width="78">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:YouthEntry">
                <TextBlock Text="{Binding Grade}" Foreground="{Binding RatingBrush}"
                           FontWeight="Bold" VerticalAlignment="Center" Margin="8,0"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Potential" Width="110">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:YouthEntry">
                <TextBlock Text="{Binding Potential}" Foreground="{StaticResource MlWarn}"
                           VerticalAlignment="Center" Margin="8,0"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Where he's at" Binding="{Binding Readiness}" Width="141"/>
        </DataGrid.Columns>
      </DataGrid>

      <!-- empty state (P6): the academy between classes is a promise, not a void -->
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6"
                  IsVisible="{Binding ShowAcademyEmpty}">
        <TextBlock Classes="ml-muted" Text="Intake day brings the next class."
                   HorizontalAlignment="Center"/>
        <Button Classes="ml-ghost" Content="📅 See when — open the Calendar" FontSize="12"
                HorizontalAlignment="Center" Foreground="{StaticResource MlLink}"
                Command="{Binding OpenCalendarCommand}"/>
      </StackPanel>

      <!-- empty state, youth: it used to be one line telling the manager to "send a young
           first-teamer down" — advice about a verb with no control anywhere on the screen.
           The verb now has a button, and the words say what the button does. -->
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                  MaxWidth="440" IsVisible="{Binding ShowYouthEmpty}">
        <TextBlock Classes="ml-muted" HorizontalAlignment="Center"
                   Text="Nobody at this level yet."/>
        <Button Classes="ml-secondary" Content="{Binding SendDownLabel}" FontSize="12"
                HorizontalAlignment="Center" Command="{Binding OpenSquadCommand}"/>
        <TextBlock Classes="ml-muted" HorizontalAlignment="Center" TextAlignment="Center"
                   TextWrapping="Wrap" Text="{Binding SendDownHint}"/>
      </StackPanel>

      <!-- FAILURE, which is not emptiness: the read used to be swallowed whole, so a broken
           side and a genuinely empty one showed the same sentence. -->
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6"
                  MaxWidth="440" IsVisible="{Binding ShowYouthError}">
        <TextBlock Classes="ml-muted" HorizontalAlignment="Center" TextAlignment="Center"
                   TextWrapping="Wrap" Foreground="{StaticResource MlDanger}"
                   Text="This side could not be read — that is a fault at our end, not an empty side."/>
        <TextBlock Classes="ml-muted" HorizontalAlignment="Center" TextAlignment="Center"
                   TextWrapping="Wrap"
                   Text="Nobody has been lost. The reason is on the status line below, and the full detail is in ml-crash.log."/>
      </StackPanel>
    </Panel>
  </DockPanel>
</UserControl>
