<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ML.App.ViewModels"
             xmlns:app="using:ML.App"
             x:Class="ML.App.Views.AcademyView"
             x:DataType="vm:AcademyViewModel">
  <DockPanel Margin="20">
    <TextBlock DockPanel.Dock="Top" Classes="ml-h1" Text="Academy" Margin="0,0,0,6"/>
    <TextBlock DockPanel.Dock="Top" Classes="ml-muted" Text="{Binding Note}" Margin="0,0,0,10"
               TextWrapping="Wrap" IsVisible="{Binding HasProspects}"/>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="14" Margin="0,12,0,0">
      <!-- P6: command CanExecute disables this until a prospect is selected -->
      <Button Content="Promote to senior squad" Command="{Binding PromoteCommand}"
              Classes="ml-primary ml-go" Padding="18,10"/>
      <TextBlock Text="{Binding Status}" Foreground="#9FE6B4" FontSize="13" VerticalAlignment="Center"/>
    </StackPanel>
    <Panel>
      <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="" Width="46">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:AcademyEntry">
                <Border Width="32" Height="32" CornerRadius="16" Background="{Binding FaceBrush}"
                        Margin="4,2" ClipToBounds="True">
                  <Panel>
                    <TextBlock Text="{Binding Mark}" Foreground="#20262E" FontSize="10"
                               FontWeight="Bold" HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    <Image Source="{Binding Portrait}" Stretch="UniformToFill"
                           IsVisible="{Binding HasPortrait}"/>
                  </Panel>
                </Border>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
          <DataGridTextColumn Header="Pos" Binding="{Binding Position}" Width="70"/>
          <DataGridTextColumn Header="Age" Binding="{Binding Age}" Width="62"/>
          <DataGridTemplateColumn Header="Rating" Width="78">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:AcademyEntry">
                <TextBlock Text="{Binding Grade}" Foreground="{Binding RatingBrush}"
                           FontWeight="Bold" VerticalAlignment="Center" Margin="8,0"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Potential" Width="110">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:AcademyEntry">
                <TextBlock Text="{Binding Potential}" Foreground="{StaticResource MlWarn}"
                           VerticalAlignment="Center" Margin="8,0"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
      <!-- empty state (P6): the academy between classes is a promise, not a void -->
      <TextBlock Classes="ml-muted" Text="Intake day brings the next class — see Calendar."
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsVisible="{Binding !HasProspects}"/>
    </Panel>
  </DockPanel>
</UserControl>
