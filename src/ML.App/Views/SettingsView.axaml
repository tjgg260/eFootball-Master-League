<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ML.App.ViewModels"
             xmlns:app="using:ML.App"
             x:Class="ML.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <ScrollViewer>
  <StackPanel Margin="28" Spacing="14" MaxWidth="1100" HorizontalAlignment="Left">
    <TextBlock Classes="ml-h1" Text="Settings"/>
    <TextBlock Text="{Binding Status}" Foreground="{StaticResource MlSuccessText}" FontSize="12"
               TextWrapping="Wrap"/>
    <TextBlock Text="{Binding SavedFlash}" Foreground="{StaticResource MlSuccessText}" FontSize="12"
               FontWeight="SemiBold"
               IsVisible="{Binding SavedFlash, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
    <WrapPanel>

    <Border Classes="ml-panel" Width="340" Margin="0,0,14,14"><StackPanel Spacing="8">
      <TextBlock Classes="ml-label" Text="Display"/>
      <TextBlock Classes="ml-muted" Text="UI skin"/>
      <ComboBox ItemsSource="{Binding Skins}" SelectedItem="{Binding SelectedSkin}"
                HorizontalAlignment="Stretch"/>
      <CheckBox IsChecked="{Binding FmAttributes}" Foreground="{StaticResource MlTextBody}"
                Content="FM view — colour bands, unscouted players hidden"/>
      <TextBlock Classes="ml-muted" TextWrapping="Wrap"
                 Text="Bands: red poor · amber average · green good · blue elite. Knowledge grows by facing clubs and scouting; coach, scout and analyst reports are always on."/>
    </StackPanel></Border>

    <Border Classes="ml-panel" Width="340" Margin="0,0,14,14"><StackPanel Spacing="8">
      <TextBlock Classes="ml-label" Text="Realism"/>
      <TextBlock Classes="ml-muted" Text="Attribute masking"/>
      <ComboBox ItemsSource="{Binding MaskOptions}" SelectedItem="{Binding MaskStrict}"
                HorizontalAlignment="Stretch"/>
      <TextBlock Classes="ml-muted" Text="Transfer difficulty"/>
      <ComboBox ItemsSource="{Binding DifficultyOptions}" SelectedItem="{Binding TransferDifficulty}"
                HorizontalAlignment="Stretch"/>
      <TextBlock Classes="ml-muted" Text="Injury frequency"/>
      <ComboBox ItemsSource="{Binding InjuryOptions}" SelectedItem="{Binding InjuryFreq}"
                HorizontalAlignment="Stretch"/>
      <TextBlock Classes="ml-muted" Text="Board patience"/>
      <ComboBox ItemsSource="{Binding SackOptions}" SelectedItem="{Binding SackLeniency}"
                HorizontalAlignment="Stretch"/>
    </StackPanel></Border>

    <Border Classes="ml-panel" Width="340" Margin="0,0,14,14"><StackPanel Spacing="8">
      <TextBlock Classes="ml-label" Text="Matchday &amp; world"/>
      <CheckBox IsChecked="{Binding AutoBoot}" Foreground="{StaticResource MlTextBody}"
                Content="Boot eFootball automatically on Play Match"/>
      <CheckBox IsChecked="{Binding RealNames}" Foreground="{StaticResource MlTextBody}"
                Content="Real club names in-game (next compile)"/>
      <TextBlock Classes="ml-muted" Text="Your manager name"/>
      <TextBox Text="{Binding ManagerName}" Watermark="The Gaffer"/>
      <TextBlock Classes="ml-muted" Text="{Binding WorldSeedLine}" TextWrapping="Wrap"/>
    </StackPanel></Border>

    <Border Classes="ml-panel" Width="340" Margin="0,0,14,14"><StackPanel Spacing="8">
      <TextBlock Classes="ml-label" Text="Match video (OBS + ffmpeg)"/>
      <CheckBox IsChecked="{Binding RecordMatches}" Foreground="{StaticResource MlTextBody}"
                Content="Record every match via OBS"/>
      <TextBlock Classes="ml-muted" Text="OBS WebSocket URL"/>
      <TextBox Text="{Binding ObsUrl}" Watermark="ws://127.0.0.1:4455"/>
      <TextBlock Classes="ml-muted" Text="OBS WebSocket password (blank if auth off)"/>
      <TextBox Text="{Binding ObsPassword}" PasswordChar="•"/>
      <TextBlock Classes="ml-muted" Text="ffmpeg path"/>
      <TextBox Text="{Binding FfmpegPath}" Watermark="ffmpeg"/>
      <TextBlock Classes="ml-muted" Text="Recordings folder (OBS output)"/>
      <TextBox Text="{Binding VideoDir}" Watermark="C:\Users\you\Videos"/>
      <TextBlock Classes="ml-muted" TextWrapping="Wrap"
                 Text="Saves as you type. Play Match starts the recording; 🎞 Analyse recording on the Dashboard stops it and mines goals, minutes and scorer suggestions. Setup: docs/video-capture.md."/>
    </StackPanel></Border>

    <Border Classes="ml-panel" Width="340" Margin="0,0,14,14"><StackPanel Spacing="8">
      <TextBlock Classes="ml-label" Text="Screenshot OCR (Steam)"/>
      <TextBlock Classes="ml-muted" Text="Steam folder"/>
      <TextBox Text="{Binding SteamRoot}"/>
      <TextBlock Classes="ml-muted" Text="Steam user id"/>
      <TextBox Text="{Binding SteamUserId}"/>
      <TextBlock Classes="ml-muted" TextWrapping="Wrap"
                 Text="Paths save as you type — the next 📷 Import uses them. While the Office is open, every new F12 screenshot in this folder is OCR'd automatically and lands as a pre-filled score for you to confirm."/>
    </StackPanel></Border>

    <Border Classes="ml-panel" Width="700" Margin="0,0,14,14"><StackPanel Spacing="8">
      <TextBlock Classes="ml-label" Text="OCR calibration (score regions)"/>
      <TextBlock Classes="ml-muted" TextWrapping="Wrap"
                 Text="Where the two full-time score boxes sit, as fractions (0–1) of the screenshot. Defaults were measured off a real 2560x1600 capture. Changes re-run OCR live against the loaded screenshot and save instantly."/>
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock Classes="ml-muted" Text="Aspect mapping" VerticalAlignment="Center"/>
        <ComboBox ItemsSource="{Binding OcrAspectOptions}" SelectedItem="{Binding OcrAspect}"
                  Width="300"/>
      </StackPanel>
      <Grid ColumnDefinitions="52,120,120,120,120" RowDefinitions="Auto,Auto,Auto">
        <TextBlock Grid.Row="0" Grid.Column="1" Classes="ml-muted" Text="x" Margin="4,0"/>
        <TextBlock Grid.Row="0" Grid.Column="2" Classes="ml-muted" Text="y" Margin="4,0"/>
        <TextBlock Grid.Row="0" Grid.Column="3" Classes="ml-muted" Text="w" Margin="4,0"/>
        <TextBlock Grid.Row="0" Grid.Column="4" Classes="ml-muted" Text="h" Margin="4,0"/>
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Home" Foreground="{StaticResource MlTextBody}"
                   FontSize="12" VerticalAlignment="Center"/>
        <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding OcrHomeX}" Minimum="0" Maximum="1"
                       Increment="0.005" FormatString="0.000" FontSize="12" Margin="2"/>
        <NumericUpDown Grid.Row="1" Grid.Column="2" Value="{Binding OcrHomeY}" Minimum="0" Maximum="1"
                       Increment="0.005" FormatString="0.000" FontSize="12" Margin="2"/>
        <NumericUpDown Grid.Row="1" Grid.Column="3" Value="{Binding OcrHomeW}" Minimum="0" Maximum="1"
                       Increment="0.005" FormatString="0.000" FontSize="12" Margin="2"/>
        <NumericUpDown Grid.Row="1" Grid.Column="4" Value="{Binding OcrHomeH}" Minimum="0" Maximum="1"
                       Increment="0.005" FormatString="0.000" FontSize="12" Margin="2"/>
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Away" Foreground="{StaticResource MlTextBody}"
                   FontSize="12" VerticalAlignment="Center"/>
        <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding OcrAwayX}" Minimum="0" Maximum="1"
                       Increment="0.005" FormatString="0.000" FontSize="12" Margin="2"/>
        <NumericUpDown Grid.Row="2" Grid.Column="2" Value="{Binding OcrAwayY}" Minimum="0" Maximum="1"
                       Increment="0.005" FormatString="0.000" FontSize="12" Margin="2"/>
        <NumericUpDown Grid.Row="2" Grid.Column="3" Value="{Binding OcrAwayW}" Minimum="0" Maximum="1"
                       Increment="0.005" FormatString="0.000" FontSize="12" Margin="2"/>
        <NumericUpDown Grid.Row="2" Grid.Column="4" Value="{Binding OcrAwayH}" Minimum="0" Maximum="1"
                       Increment="0.005" FormatString="0.000" FontSize="12" Margin="2"/>
      </Grid>
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button Classes="ml-primary" Content="🧪 Test OCR now" Command="{Binding TestOcrCommand}"/>
        <Button Classes="ml-secondary" Content="Reset to defaults"
                Command="{Binding ResetOcrRegionsCommand}" FontSize="12"/>
      </StackPanel>
      <TextBlock Text="{Binding OcrResultLine}" Foreground="{StaticResource MlSuccessText}"
                 FontSize="12" TextWrapping="Wrap" FontFamily="Consolas"/>
      <StackPanel Orientation="Horizontal" Spacing="14">
        <StackPanel Spacing="4">
          <TextBlock Classes="ml-muted" Text="Home score crop"/>
          <Border Background="{StaticResource MlSurfaceApp}" BorderBrush="{StaticResource MlBorder}"
                  BorderThickness="1" CornerRadius="4" Padding="4">
            <Image Source="{Binding OcrHomeCrop}" Width="150" Stretch="Uniform"/>
          </Border>
        </StackPanel>
        <StackPanel Spacing="4">
          <TextBlock Classes="ml-muted" Text="Away score crop"/>
          <Border Background="{StaticResource MlSurfaceApp}" BorderBrush="{StaticResource MlBorder}"
                  BorderThickness="1" CornerRadius="4" Padding="4">
            <Image Source="{Binding OcrAwayCrop}" Width="150" Stretch="Uniform"/>
          </Border>
        </StackPanel>
      </StackPanel>
      <Border Background="{StaticResource MlSurfaceApp}" BorderBrush="{StaticResource MlBorder}"
              BorderThickness="1" CornerRadius="4" Padding="4" HorizontalAlignment="Left">
        <Image Source="{Binding OcrScreenshot}" MaxWidth="640" Stretch="Uniform"/>
      </Border>
    </StackPanel></Border>

    <Border Classes="ml-panel" Width="340" Margin="0,0,14,14"><StackPanel Spacing="8">
      <TextBlock Classes="ml-label" Text="Data"/>
      <Button Classes="ml-secondary" Content="💾 Backup now" Command="{Binding BackupNowCommand}"/>
      <TextBlock Classes="ml-muted" Text="Restore a backup (applies at next launch)"/>
      <ComboBox ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}"
                HorizontalAlignment="Stretch"/>
      <TextBlock Classes="ml-muted" Text="No backups yet — take one and it lands here."
                 IsVisible="{Binding !Backups.Count}"/>
      <Button Content="↩ Restore selected" Command="{Binding RestoreBackupCommand}"
              Background="#3A2A10" Foreground="{StaticResource MlWarn}" Padding="14,8"
              CornerRadius="{StaticResource MlRadiusControl}"/>
    </StackPanel></Border>

    </WrapPanel>
  </StackPanel>
  </ScrollViewer>
</UserControl>
