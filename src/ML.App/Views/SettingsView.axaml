<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ML.App.ViewModels"
             xmlns:app="using:ML.App"
             x:Class="ML.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <ScrollViewer>
  <StackPanel Margin="28" Spacing="14" MaxWidth="1100" HorizontalAlignment="Left">
    <TextBlock Classes="ml-h1" Text="Settings"/>
    <TextBlock Text="{Binding Status}" Foreground="{StaticResource MlSuccessText}" FontSize="12"
               TextWrapping="Wrap"/>
    <TextBlock Text="{Binding SavedFlash}" Foreground="{StaticResource MlSuccessText}" FontSize="12"
               FontWeight="SemiBold"
               IsVisible="{Binding SavedFlash, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
    <WrapPanel>

    <Border Classes="ml-panel" Width="340" Margin="0,0,14,14"><StackPanel Spacing="8">
      <TextBlock Classes="ml-label" Text="Display"/>
      <TextBlock Classes="ml-muted" Text="UI skin"/>
      <ComboBox ItemsSource="{Binding Skins}" SelectedItem="{Binding SelectedSkin}"
                HorizontalAlignment="Stretch"/>
      <CheckBox IsChecked="{Binding FmAttributes}" Foreground="{StaticResource MlTextBody}"
                Content="FM view — colour bands, unscouted players hidden"/>
      <TextBlock Classes="ml-muted" TextWrapping="Wrap"
                 Text="Bands: red poor · amber average · green good · blue elite. Knowledge grows by facing clubs and scouting; coach, scout and analyst reports are always on."/>
    </StackPanel></Border>

    <Border Classes="ml-panel" Width="340" Margin="0,0,14,14"><StackPanel Spacing="8">
      <TextBlock Classes="ml-label" Text="Realism"/>
      <TextBlock Classes="ml-muted" Text="Attribute masking"/>
      <ComboBox ItemsSource="{Binding MaskOptions}" SelectedItem="{Binding MaskStrict}"
                HorizontalAlignment="Stretch"/>
      <TextBlock Classes="ml-muted" Text="Transfer difficulty"/>
      <ComboBox ItemsSource="{Binding DifficultyOptions}" SelectedItem="{Binding TransferDifficulty}"
                HorizontalAlignment="Stretch"/>
      <TextBlock Classes="ml-muted" Text="Injury frequency"/>
      <ComboBox ItemsSource="{Binding InjuryOptions}" SelectedItem="{Binding InjuryFreq}"
                HorizontalAlignment="Stretch"/>
      <TextBlock Classes="ml-muted" Text="Board patience"/>
      <ComboBox ItemsSource="{Binding SackOptions}" SelectedItem="{Binding SackLeniency}"
                HorizontalAlignment="Stretch"/>
    </StackPanel></Border>

    <Border Classes="ml-panel" Width="340" Margin="0,0,14,14"><StackPanel Spacing="8">
      <TextBlock Classes="ml-label" Text="Matchday &amp; world"/>
      <CheckBox IsChecked="{Binding AutoBoot}" Foreground="{StaticResource MlTextBody}"
                Content="Boot eFootball automatically on Play Match"/>
      <CheckBox IsChecked="{Binding RealNames}" Foreground="{StaticResource MlTextBody}"
                Content="Real club names in-game (next compile)"/>
      <TextBlock Classes="ml-muted" Text="Your manager name"/>
      <TextBox Text="{Binding ManagerName}" Watermark="The Gaffer"/>
      <TextBlock Classes="ml-muted" Text="{Binding WorldSeedLine}" TextWrapping="Wrap"/>
    </StackPanel></Border>

    <Border Classes="ml-panel" Width="460" Margin="0,0,14,14"><StackPanel Spacing="8">
      <TextBlock Classes="ml-label" Text="Match data (efootball-re stats host)"/>
      <TextBlock Classes="ml-muted" Text="eFootball install folder"/>
      <TextBox Text="{Binding GameDir}" Watermark="C:\Program Files (x86)\Steam\steamapps\common\eFootball"/>
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button Classes="ml-secondary" Content="↻ Check" Command="{Binding CheckMatchExportsCommand}" FontSize="12"/>
      </StackPanel>
      <TextBlock Text="{Binding MatchExportStatus}" Foreground="{StaticResource MlTextBody}"
                 FontSize="12" TextWrapping="Wrap"/>
      <TextBlock Classes="ml-muted" TextWrapping="Wrap"
                 Text="The stats host from efootball-re runs inside the game and writes every finished match to ml_stats\ in this folder. The Office pre-fills the score, scorers and ratings from it for you to confirm. Setup is on the efootball-re side: memprobe/deploy_host.sh, then see its mlstats/README.md."/>
    </StackPanel></Border>

    <Border Classes="ml-panel" Width="340" Margin="0,0,14,14"><StackPanel Spacing="8">
      <TextBlock Classes="ml-label" Text="Career vault"/>
      <Button Classes="ml-primary" Content="🗄 Save career to vault" Command="{Binding SaveToVaultCommand}"/>
      <Button Classes="ml-secondary" Content="⇄ Switch / load / new career…" Command="{Binding SwitchCareerCommand}"/>
      <TextBlock Classes="ml-muted" Text="{Binding VaultStatus}" TextWrapping="Wrap"
                 IsVisible="{Binding VaultStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
    </StackPanel></Border>

    <Border Classes="ml-panel" Width="340" Margin="0,0,14,14"><StackPanel Spacing="8">
      <TextBlock Classes="ml-label" Text="Data"/>
      <Button Classes="ml-secondary" Content="💾 Backup now" Command="{Binding BackupNowCommand}"/>
      <TextBlock Classes="ml-muted" Text="Restore a backup (applies at next launch)"/>
      <ComboBox ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}"
                HorizontalAlignment="Stretch"/>
      <TextBlock Classes="ml-muted" Text="No backups yet — take one and it lands here."
                 IsVisible="{Binding !Backups.Count}"/>
      <!-- The label IS the confirmation (the Staff and Finances idiom): the first press turns
           it into a question naming the copy's date, the second press stages the restore. -->
      <Button Content="{Binding RestoreLabel}" Command="{Binding RestoreBackupCommand}"
              Background="#3A2A10" Foreground="{StaticResource MlWarn}" Padding="14,8"
              CornerRadius="{StaticResource MlRadiusControl}"/>
    </StackPanel></Border>

    </WrapPanel>
  </StackPanel>
  </ScrollViewer>
</UserControl>
