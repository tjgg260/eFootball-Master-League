@inject Db Db

@if (Id is long id)
{
    var bio = Db.Bio(id);
    var attrs = Db.Attributes(id);
    var skills = Db.Skills(id);
    var (pri, sec) = Db.Playstyles(id);
    var isGk = bio.Position.ToUpperInvariant() == "GK";
    var axes = isGk ? GkAxes : OutAxes;
    var vals = axes.Select(a => Avg(attrs, a.Attrs)).ToArray();

    <div class="profile">
        @* -- card 1: bio -- *@
        <div class="pcard">
            <div class="bio">
                @if (Db.FaceDataUri(bio.FacePath) is { } uri)
                { <img class="photo" src="@uri" alt="" /> }
                else
                { <div class="photo mono">no photo</div> }
                <div class="who">
                    <span class="pill @Unit(bio.Position).ToLowerInvariant()" style="align-self:flex-start"><span>@bio.Position.ToUpperInvariant()</span></span>
                    <div class="pname">@bio.Name</div>
                    <div class="psub">@TeamName@(bio.Nationality is { Length: > 0 } ? $" · {bio.Nationality}" : "")@(bio.Age > 0 ? $" · {bio.Age}" : "")</div>
                    <div class="povr">@bio.Overall</div>
                </div>
            </div>
            <div class="facts">
                <div class="fact"><div class="label">Status</div><div class="v">@Status</div></div>
                <div class="fact"><div class="label">Height</div><div class="v">@(bio.HeightCm > 0 ? $"{bio.HeightCm} cm" : "—")</div></div>
                <div class="fact"><div class="label">Weight</div><div class="v">@(bio.WeightKg > 0 ? $"{bio.WeightKg} kg" : "—")</div></div>
                <div class="fact"><div class="label">Contract</div><div class="v">—</div></div>
            </div>
            <div>
                <div class="label" style="margin-bottom:6px">Playstyles</div>
                <div class="tagrow">
                    @if (pri is { Length: > 0 } && pri != "Basic") { <span class="tag hot">Attacking · @pri</span> }
                    @if (sec is { Length: > 0 } && sec != "Basic") { <span class="tag">Defending · @sec</span> }
                    @if ((pri is null or "Basic" or "") && (sec is null or "Basic" or "")) { <span class="tag">No defined playstyle</span> }
                </div>
            </div>
            @if (skills.Count > 0)
            {
                <div style="overflow:hidden">
                    <div class="label" style="margin-bottom:6px">Skills</div>
                    <div class="tagrow">
                        @foreach (var s in skills.Take(8)) { <span class="tag">@s</span> }
                        @if (skills.Count > 8) { <span class="tag">+@(skills.Count - 8)</span> }
                    </div>
                </div>
            }
            <div class="actions">
                <button class="btn">Renew contract</button>
                <button class="btn ghost">List</button>
            </div>
        </div>

        @* -- card 2: ability radar + growth -- *@
        <div class="pcard">
            <div class="label">Ability</div>
            <div class="radarwrap">
                <svg viewBox="0 0 140 140">
                    <polygon points="@Ring(1.0)" fill="none" stroke="var(--line)" stroke-width="1"></polygon>
                    <polygon points="@Ring(0.66)" fill="none" stroke="var(--line)" stroke-width="1"></polygon>
                    <polygon points="@Ring(0.33)" fill="none" stroke="var(--line)" stroke-width="1"></polygon>
                    <polygon points="@RadarPts(vals)" fill="rgba(47,91,255,.28)" stroke="var(--kickoff)" stroke-width="2"></polygon>
                </svg>
                <div class="radarlist">
                    @for (var i = 0; i < axes.Length; i++)
                    {
                        <div class="r"><span class="n">@axes[i].Label</span><span class="v">@vals[i]</span></div>
                    }
                </div>
            </div>
            <div class="label">Growth · overall by season</div>
            <svg class="growth" viewBox="0 0 250 110" preserveAspectRatio="none">
                <line x1="0" y1="96" x2="250" y2="96" stroke="var(--line)" stroke-width="1"></line>
                <rect x="122.5" y="53.5" width="5" height="5" fill="var(--pitch)"></rect>
                <text x="125" y="44" fill="var(--text-3)" font-size="10" text-anchor="middle" font-family="IBM Plex Mono,monospace">@bio.Overall</text>
                <text x="125" y="108" fill="var(--text-3)" font-size="8" text-anchor="middle" font-family="IBM Plex Sans,sans-serif">history begins with your first season</text>
            </svg>
        </div>

        @* -- card 3: attributes -- *@
        <div class="pcard">
            <div class="attrhead"><span class="label">Attributes</span><span class="hint">deltas after first season</span></div>
            <div class="attrs">
                @if (attrs.Count == 0)
                {
                    <div class="tag" style="align-self:flex-start">No attribute data for this player yet</div>
                }
                else
                {
                    @foreach (var grp in (isGk ? GkGroups : OutGroups))
                    {
                        <div>
                            <div class="g">@grp.Title</div>
                            @foreach (var a in grp.Attrs)
                            {
                                var v = attrs.TryGetValue(a.Key, out var x) ? x : 0;
                                <div class="arow">
                                    <span class="n">@a.Label</span>
                                    <span class="bar"><i style="width:@(Pct(v))%"></i></span>
                                    <span class="v">@(v > 0 ? v.ToString() : "—")</span>
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public long? Id { get; set; }
    [Parameter] public string TeamName { get; set; } = "";
    [Parameter] public string Status { get; set; } = "—";

    private record Axis(string Label, string[] Attrs);
    private record Attr(string Key, string Label);
    private record Group(string Title, Attr[] Attrs);

    private static readonly Axis[] OutAxes =
    {
        new("Attack", new[]{"offensive_awareness","finishing"}),
        new("Technique", new[]{"ball_control","dribbling","tight_possession"}),
        new("Passing", new[]{"low_pass","lofted_pass","curl"}),
        new("Defence", new[]{"defensive_awareness","tackling","defensive_engagement"}),
        new("Speed", new[]{"speed","acceleration"}),
        new("Physical", new[]{"physical_contact","stamina","jumping"}),
    };
    private static readonly Axis[] GkAxes =
    {
        new("Reflexes", new[]{"gk_reflexes"}), new("Catching", new[]{"gk_catching"}),
        new("Reach", new[]{"gk_reach"}), new("Awareness", new[]{"gk_awareness"}),
        new("Parrying", new[]{"gk_parrying"}), new("Speed", new[]{"speed","acceleration"}),
    };

    private static readonly Group[] OutGroups =
    {
        new("Attacking", new[]{new Attr("offensive_awareness","Off. awareness"),new Attr("finishing","Finishing"),new Attr("heading","Heading"),new Attr("kicking_power","Kicking power")}),
        new("Ball & pass", new[]{new Attr("ball_control","Ball control"),new Attr("dribbling","Dribbling"),new Attr("tight_possession","Tight possession"),new Attr("low_pass","Low pass"),new Attr("lofted_pass","Lofted pass"),new Attr("curl","Curl")}),
        new("Physical", new[]{new Attr("speed","Speed"),new Attr("acceleration","Acceleration"),new Attr("physical_contact","Physical contact"),new Attr("balance","Balance"),new Attr("stamina","Stamina"),new Attr("jumping","Jumping")}),
        new("Defending", new[]{new Attr("defensive_awareness","Def. awareness"),new Attr("tackling","Tackling"),new Attr("defensive_engagement","Def. engagement"),new Attr("aggression","Aggression")}),
    };
    private static readonly Group[] GkGroups =
    {
        new("Goalkeeping", new[]{new Attr("gk_awareness","GK awareness"),new Attr("gk_catching","GK catching"),new Attr("gk_parrying","GK parrying"),new Attr("gk_reflexes","GK reflexes"),new Attr("gk_reach","GK reach")}),
        new("Physical", new[]{new Attr("speed","Speed"),new Attr("acceleration","Acceleration"),new Attr("jumping","Jumping"),new Attr("balance","Balance")}),
    };

    private static int Avg(Dictionary<string, int> a, string[] keys)
    {
        var vals = keys.Where(a.ContainsKey).Select(k => a[k]).ToList();
        return vals.Count == 0 ? 40 : (int)vals.Average();
    }
    private static double Pct(int v) => Math.Clamp((v - 40) / 59.0 * 100, 0, 100);
    private static string F(double d) => d.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);

    private static (double X, double Y) Pt(double frac, int i, int n)
    {
        var a = Math.PI * 2 * i / n - Math.PI / 2;
        return (70 + 54 * frac * Math.Cos(a), 70 + 54 * frac * Math.Sin(a));
    }
    private static string Ring(double k)
        => string.Join(" ", Enumerable.Range(0, 6).Select(i => { var p = Pt(k, i, 6); return $"{F(p.X)},{F(p.Y)}"; }));
    private static string RadarPts(int[] vals)
        => string.Join(" ", vals.Select((v, i) => { var p = Pt(Math.Clamp((v - 40) / 59.0, 0, 1), i, vals.Length); return $"{F(p.X)},{F(p.Y)}"; }));

    private static string Unit(string pos) => pos.ToUpperInvariant() switch
    {
        "GK" => "GK",
        "CB" or "LB" or "RB" or "LWB" or "RWB" => "DEF",
        "DMF" or "CMF" or "LMF" or "RMF" or "AMF" => "MID",
        _ => "FWD",
    };
}
