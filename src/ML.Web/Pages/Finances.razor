@page "/finances"
@inject Db Db
@inject AppState State

<div class="content">
    <div class="toolbar">
        <div class="chyron"><span>Finances</span></div>
    </div>

    @if (State.Career is not { } c)
    {
        <div class="pcard"><div style="font:400 13px/18px var(--font-body);color:var(--text-3)">No career yet.</div></div>
    }
    else
    {
        <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px">
            <div class="pcard">
                <div class="label">Balance</div>
                <div class="d-wide" style="font-size:34px;color:@(_budget >= 0 ? "var(--win)" : "var(--loss)")">£@Fmt(_budget)</div>
                <div style="font:400 12px/16px var(--font-body);color:var(--text-2)">Club account · season @c.SeasonId</div>
            </div>
            <div class="pcard">
                <div class="label">Season income</div>
                <div class="d-wide" style="font-size:34px;color:var(--win)">£@Fmt(_income)</div>
                <div style="font:400 12px/16px var(--font-body);color:var(--text-2)">Gate receipts, prize money, sales</div>
            </div>
            <div class="pcard">
                <div class="label">Season spend</div>
                <div class="d-wide" style="font-size:34px;color:var(--loss)">£@Fmt(_spend)</div>
                <div style="font:400 12px/16px var(--font-body);color:var(--text-2)">Wages, transfers, loan repayments</div>
            </div>
        </div>
        <div class="pcard" style="flex:1">
            <div class="attrhead"><span class="label">Income vs spend</span><span class="hint">weekly view lands with the season</span></div>
            <div style="flex:1;display:flex;align-items:flex-end;gap:8px;padding:12px 0">
                <div style="flex:1;display:flex;flex-direction:column;gap:4px;align-items:center">
                    <div style="width:60%;background:var(--pitch);height:@BarH(_income)px"></div>
                    <span class="label">Income</span>
                </div>
                <div style="flex:1;display:flex;flex-direction:column;gap:4px;align-items:center">
                    <div style="width:60%;background:var(--loss);height:@BarH(_spend)px"></div>
                    <span class="label">Spend</span>
                </div>
                <div style="flex:2;padding:0 20px;font:400 13px/19px var(--font-body);color:var(--text-2);text-wrap:pretty">
                    Net so far: <span style="color:@(_income - _spend >= 0 ? "var(--win)" : "var(--loss)");font-weight:700">£@Fmt(_income - _spend)</span>.
                    Weekly wage flow, sponsor payments and budget requests arrive as those systems come across from the career engine.
                </div>
            </div>
        </div>
    }
</div>

@code {
    private long _budget, _income, _spend;

    protected override void OnInitialized()
    {
        if (State.Career is not { } c) return;
        (_budget, _income, _spend) = Db.Finances(c.TeamId, c.SeasonId);
    }

    private static string Fmt(long v) => Math.Abs(v) >= 1_000_000
        ? $"{v / 1_000_000.0:0.#}m" : Math.Abs(v) >= 1_000 ? $"{v / 1_000.0:0.#}k" : v.ToString();

    private int BarH(long v)
    {
        var max = Math.Max(Math.Max(_income, _spend), 1);
        return (int)(30 + 150.0 * v / max);
    }
}
