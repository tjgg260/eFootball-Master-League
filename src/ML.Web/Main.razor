@* Root component — routes into the app shell *@
<Router AppAssembly="@typeof(Main).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(Shell)" />
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(Shell)">
            <div class="pad">Screen not found.</div>
        </LayoutView>
    </NotFound>
</Router>
